---
import { ClientRouter } from "astro:transitions";

import "../styles/site.css";
import "../styles/consent.css";
import Icon from "../components/Icon.astro";
import { book, MEDIACONTEXT, SITE, SOCIALS, tone, type Color, type Fig } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  fig: Fig;
  color?: Color;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  variant?: "index" | "document";
}
const { title, description = SITE.description, fig, color = "blue", image = "/og-image.jpg", type = "website", publishedTime, variant = "document" } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const isProduct = fig === "radar";
const isNotes = fig === "flask" || fig === "notes" || fig === "press";
const action = isProduct
  ? { label: MEDIACONTEXT.cta, href: book("mediacontext-bar"), external: true }
  : isNotes
    ? { label: "Get new notes by email", href: "#subscribe", external: false }
    : { label: "Book a scoping call", href: book(fig === "growth" ? "fdm-bar" : "home-bar"), external: true };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#f5f7fa" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title="And/or Labs field notes" href="/rss.xml" />
  <link rel="preload" href="/fonts/newsreader/Newsreader-latin-var.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/departure-mono/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@eclecticV" />
  <ClientRouter fallback="swap" />
</head>
<body>
  <nav aria-label="Skip links"><a class="skip" href="#main">Skip to content</a></nav>
  <div class:list={["sheet", variant, { reading: type === "article" }]}>
    <div class="frame">
      <main id="main" class="pane" tabindex="-1" data-fig={fig} style={tone(color)}>
        <header class="pane-head">
          <a class="mark" href="/" aria-label="And/or Labs, home"><b aria-hidden="true">&amp;</b>And/or Labs</a>
          <slot name="crumb" />
        </header>
        <slot />
      </main>
      <aside class="viz" transition:persist="figure" aria-hidden="true"><canvas id="figure"></canvas></aside>
      <footer class="site-footer">
        <span class="label">And/or Labs</span>
        <nav aria-label="Elsewhere">
        {SOCIALS.map(s => (
          <a href={s.href} {...(s.id === "email" ? {} : { target: "_blank", rel: "noopener" })}><Icon name={s.id} /><span>{s.label}</span></a>
        ))}
        </nav>
      </footer>
      <nav class="bar" aria-label="Next step">
        <a class="book" href={action.href} {...(action.external ? { target: "_blank", rel: "noopener" } : {})}>{action.label}<span class="arr" aria-hidden="true">{action.external ? "↗" : "↓"}</span></a>
        <a class="bar-email" href={SOCIALS[0].href} aria-label="Email And/or Labs"><Icon name="email" /><span>Email</span></a>
      </nav>
    </div>
  </div>
  <script>
    import "../scripts/site.ts";
  </script>
</body>
</html>
