---
import { Button, Panel } from "@andor/ds";
import { BOOKING_URL, SITE } from "@/data/site";
---

<Panel variant="bottom">
  <section class="container py-24 text-center lg:py-32" aria-labelledby="closing-title">
    <h2 id="closing-title" class="mx-auto max-w-3xl text-4xl font-semibold leading-[1.05] tracking-[-0.035em] md:text-6xl">{SITE.tagline}</h2>
    <Button href={BOOKING_URL} target="_blank" rel="noopener noreferrer" size="lg" className="mt-10">Book a call</Button>
  </section>
</Panel>
