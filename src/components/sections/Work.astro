---
import { Label } from "@andor/ds";
import { ArrowUpRight } from "lucide-react";
import { CASE_STUDY as cs } from "@/data/site";
---

<section id="work" class="bg-muted/60 py-20 lg:py-28" aria-labelledby="work-title">
  <div class="container grid items-center gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
    <div>
      <Label marker={1}>Case study · {cs.service}</Label>
      <h2 id="work-title" class="mt-4 text-3xl font-semibold leading-[1.1] md:text-4xl">{cs.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">{cs.summary}</p>

      <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-border shadow-[0_0_0_1px_var(--border)] sm:grid-cols-4">
        {cs.metrics.map((m) => (
          <div class="bg-card px-4 py-4">
            <dt class="font-label text-[10px] uppercase tracking-[0.08em] text-muted-foreground">{m.label}</dt>
            <dd class="mt-2 text-xl font-semibold tracking-[-0.02em] tabular-nums">{m.value}</dd>
          </div>
        ))}
      </dl>

      <figure class="mt-8 border-l-2 border-primary pl-5">
        <blockquote class="text-[15px] leading-relaxed">“{cs.quote}”</blockquote>
        <figcaption class="mt-3 text-sm text-muted-foreground"><span class="font-medium text-foreground">{cs.quoteBy}</span>, {cs.quoteRole}</figcaption>
      </figure>

      <a href={cs.url} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex items-center gap-1 text-sm font-medium">
        Visit {cs.client} <ArrowUpRight className="size-4" />
      </a>
    </div>

    <div class="relative pb-16 sm:pb-20">
      <figure class="overflow-hidden rounded-2xl bg-card p-1.5 shadow-[0_0_0_1px_var(--border),var(--shadow-panel)]">
        <img src={cs.after.src} alt={cs.after.alt} width="1600" height="810" loading="lazy" decoding="async" class="block w-full rounded-xl" />
        <figcaption class="sr-only">After</figcaption>
      </figure>
      <figure class="absolute -bottom-0 left-4 w-[48%] -rotate-2 overflow-hidden rounded-xl bg-card p-1 shadow-[0_0_0_1px_var(--border),var(--shadow-panel)] sm:left-8">
        <img src={cs.before.src} alt={cs.before.alt} width="1280" height="800" loading="lazy" decoding="async" class="block w-full rounded-lg" />
        <figcaption class="absolute left-3 top-3 rounded-md bg-background/90 px-2 py-1 font-label text-[10px] uppercase tracking-[0.08em] text-muted-foreground">Before</figcaption>
      </figure>
      <span class="absolute right-3 top-3 rounded-md bg-background/90 px-2 py-1 font-label text-[10px] uppercase tracking-[0.08em] text-muted-foreground">After</span>
    </div>
  </div>
</section>
