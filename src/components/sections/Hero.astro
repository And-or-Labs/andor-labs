---
import StatusMark from "../ds/StatusMark.astro";
import Horizon from "../Horizon.astro";
import Badge from "../ds/Badge.astro";
import Input from "../ds/Input.astro";
import Button from "../ds/Button.astro";
import { PROMISE } from "../../config";

/**
 * Launch partners — official marks.
 *
 * `w`/`h` are the SOURCE's intrinsic dimensions so each reserves its box before
 * it loads and the row does not reflow; they only set the aspect ratio.
 *
 * `mark` is the OPTICAL height, and it has to be per-mark because a bounding
 * box says nothing about how big a logo looks. Snitcher's viewBox is cropped
 * tight to its letterforms, so at a shared height it towers over everything;
 * the NVIDIA asset is a framed badge with its artwork inset, so at the same
 * height it reads as a stamp. These were set by eye against each other, which
 * is the only way a logo row is ever evened up.
 *
 * NVIDIA is the Inception program lockup rather than the corporate wordmark —
 * that is the actual relationship, and the plain NVIDIA logo would claim a
 * different one.
 *
 * `dim` is per-mark opacity, and it has to be, for the same reason `mark` does.
 * A shared opacity does not produce an even row because the marks differ in how
 * much ink they put on the page: measured as rendered, AirOps came out at 0.328
 * mean ink and Boardy at 0.358 while the NVIDIA badge — mostly white plaque —
 * came out at 0.099. A 3.6x spread under one opacity is why AirOps looked
 * darker than Boardy.
 *
 * These values normalise each to roughly the same effective ink. They were
 * computed, not guessed: render each mark as the bar draws it, average
 * (1 - luminance) across its box, and divide a common target by that. NVIDIA is
 * clamped at 0.85 — it is sparse rather than light, so evening it out fully
 * would need it at more than 1.
 *
 * ⚠️ Boardy is a PNG. It is the only one not available as an SVG: boardy.ai
 * ships its mark as a .webp and publishes no vector (the only SVGs on the site
 * are third-party channel icons). Swap it the moment they publish one.
 */
const PARTNERS = [
  { name: "NVIDIA Inception", src: "/partners/nvidia-inception.svg", w: 500, h: 216, mark: 36, dim: 1 },
  { name: "AirOps", src: "/partners/airops.svg", w: 235, h: 82, mark: 24, dim: 0.47 },
  { name: "Snitcher", src: "/partners/snitcher.svg", w: 122, h: 23, mark: 15, dim: 0.58 },
  { name: "Superdesign", src: "/partners/superdesign.svg", w: 26, h: 30, mark: 26, dim: 0.64 },
  { name: "Boardy", src: "/partners/boardy.png", w: 119, h: 128, mark: 28, dim: 0.43 },
];

---
<section class="aol-hero" style="border-bottom:1px solid var(--ink-200);background:var(--paper)">
  <div class="aol-hero-inner aol-has-horizon" style="max-width:var(--container-width);width:100%;margin:0 auto">
    <Horizon name="northstar" width={952} height={320} eager />
    <div class="aol-eyebrow aol-hero__eyebrow" data-r style="--r:0">Est. 2025</div>
    {/* The founder line moved to the launch-partners band at the foot of the
        section — it is the same claim as the logos and belongs beside them.
        The --r stages below revert to what they were before it sat here. */}
    <h1 class="aol-hero__headline" data-r style="font-family:var(--font-display);font-weight:400;font-size:42px;line-height:1.18;letter-spacing:0;max-width:30.5rem;--r:1">Don't just go-to-market. Win it.</h1>
    <p class="aol-hero__subhead" data-r style="font-size:21px;line-height:1.5;color:var(--ink-600);max-width:42ch;--r:2">
      {PROMISE}
    </p>
    {/* Two asks, ranked. The booking call is the primary; the free tool sits
        directly under it as the lighter option for someone not ready to talk to
        a human yet. Stacked rather than side-by-side so it reads as a fallback
        instead of an equal choice — this used to hang off the header button,
        where it competed with the nav instead of following the promise.

        The second ask is withdrawn as of 2026-08-21: Rank My AdTech is back to
        WIP and its routes are gone, so this was the homepage pointing at a 404.
        Commented rather than deleted, like the founder line above — the
        `aol-hero__alt` rule stays in site.css so uncommenting is the only step.
        See docs/WIP-rank-my-adtech.md. */}
    {/* The primary ask is the free audit, and it lives here rather than in the
        header for two reasons. It reads directly under the promise, which is
        what earns it — a lead magnet asking for an address before saying what
        it does is just a form. And it sits beside the terminal it opens, so the
        modal grows out of the machine the visitor is already looking at.

        ONE FIELD on purpose: the site to crawl is derived from the address's
        domain (functions/_lib/email-domain.ts), so a second input would double
        the friction for something we can usually infer. Free-mail addresses
        cannot be, and get asked inside the modal instead.

        The booking is not gone — it is in the header on every page, which is
        the right distance for someone who already knows they want to talk. */}
    <div class="aol-hero__cta" data-r style="--r:4">
      <form class="aol-hero__auditform" novalidate>
        {/* The label is present but not painted. "No visible label" is a design
            decision; "no label" would be an accessibility bug — a bare input
            with only a placeholder announces nothing once the placeholder is
            typed over, and placeholders are not accessible names. */}
        <label class="aol-visually-hidden" for="hero-audit-email">Work email</label>
        <div class="aol-hero__auditrow">
          <Input
            id="hero-audit-email"
            class="aol-hero__auditinput"
            type="email"
            name="email"
            inputmode="email"
            autocomplete="email"
            placeholder="you@company.com"
            required
          />
          <Button type="submit" size="sm" variant="primary" class="aol-hero__auditgo">Get 3 quick wins</Button>
        </div>
        <p class="aol-hero__auditerr" role="alert" hidden></p>

        {/* What it costs to say yes, answered before it is asked. Both are the
            two objections a stranger has to an email field: how long is this
            going to take, and am I about to be made to create an account.

            StatusMark is the system's yes/no glyph — the same mark the
            comparison table and the offer cards use — rather than a tick typed
            into the copy. */}
        <ul class="aol-hero__assurances">
          <li><StatusMark kind="yes" size={15} /> Takes 30 seconds</li>
          <li><StatusMark kind="yes" size={15} /> No sign up needed</li>
        </ul>

        {/* Progress, under the field, appearing only once a run starts.
            Discrete jumps through the crawl, then elapsed-time through scoring,
            capped below 100 until the result lands — a bar sitting full while
            nothing happens is worse than one honestly still crawling. */}
        <div class="aol-hero__progress" hidden>
          <div class="aol-meter" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <span class="aol-meter__fill"></span>
          </div>
          <p class="aol-hero__status" role="status" aria-live="polite"></p>
        </div>

      </form>
      {/* <a class="aol-hero__alt" href="/tools/rank-my-adtech/">Get your company ranked by three AI labs <span aria-hidden="true">&rarr;</span></a> */}
    </div>

    {/* ── The horizon ──────────────────────────────────────────────────────
        A researcher taking a bearing off the north star, full bleed along the
        foot of the hero: solid at the bottom, dissolving upward into the paper.

        The dissolve is a MASK, not a scrim. It fades the image's own alpha, so
        it lands on whatever is behind it and the paper colour is never written
        into the rule — which matters, because the tokens under this page have
        moved before and a hardcoded gradient survives that change looking
        wrong.

        It sits BETWEEN the copy and the credibility strip rather than behind
        the whole hero. This picture is a night scene, and behind the copy it
        would want a scrim and fight the paper ground; along the foot it is the
        ground the promise stands on.

        It fills .aol-hero-inner — the region between the header and the
        credibility strip — and bleeds past the container's 1200px cap with a
        100vw child, because inside the cap it stopped at 1152px on a 1440
        screen and read as a picture someone placed rather than as the ground
        the page stands on.

        NO data-r. The staged reveal is for the things a reader arrives at in
        order; the ground is simply there, and sliding it up behind the copy
        drew the eye to the one element that should not ask for it.

        DECORATIVE: aria-hidden, empty alt, real dimensions so it reserves its
        box — this is above the fold on a short viewport. */}

  </div>
  {/* ── Launch partners ──────────────────────────────────────────────────
      The logo bar, back at the foot of the first screen on the engineering
      grid: credentials on the left, partners on the right.

      Tried inside the hero and taken out again — over the picture the marks
      needed fading so far to belong that they stopped reading, and a Card
      floating on the horizon put a second surface on top of a treatment that
      was already doing the work.

      OFFICIAL MARKS, sized by HEIGHT and per mark. They arrive as five
      different kinds of asset at aspect ratios from 1:1 to nearly 3:1;
      constrain the width and a square mark towers over a wordmark.

      --r:6 keeps it last in the staged reveal, after the field. */}
  <div class="aol-grid-blue aol-partners" data-r style="border-top:1px solid var(--ink-200);--r:6">
    <div class="aol-partners__inner">
      <p class="aol-partners__founder">Founded by the ex head of marketing<br />@ <strong>Blockthrough</strong> and <strong>AdPushup</strong> <Badge variant="outline" class="aol-founderpill">sold for &gt;$100M</Badge></p>
      {/* The label sits BESIDE the marks, not above them, and it is a Badge —
          the system's label — rather than an eyebrow. Stacked above the row it
          read as a section heading for the whole bar, which put it in charge of
          the credential on the left as well. Inline and boxed, it labels only
          what follows it.

          BOTH badges in this band are `outline`. They were on different
          variants — the exit tinted blue, this one outlined — which reads as
          two kinds of label rather than one, in a band eighty pixels tall.
          Outline for both, and blue stays what it is everywhere else on the
          site: the signal for actions and active states, not a label colour. */}
      <div class="aol-partners__side">
        <Badge variant="outline" class="aol-partners__label">Launch partners</Badge>
        <ul class="aol-partners__row">
          {PARTNERS.map((p) => (
            <li class="aol-partners__item" style={`--mark-h:${p.mark}px;--mark-o:${p.dim}`}>
              <img src={p.src} alt={p.name} width={p.w} height={p.h} loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  // ── The audit, run in place ──────────────────────────────────────────────
  // No navigation. The wait is the problem a lead magnet has to solve, and
  // sending somebody to a loading screen makes it worse — it throws away the
  // promise they just read. The bar fills under the field, and the answer
  // arrives in the receipt below as the next thing to read.
  const auditForm = document.querySelector<HTMLFormElement>(".aol-hero__auditform");
  const auditInput = auditForm?.querySelector<HTMLInputElement>(".aol-hero__auditinput");
  const auditErr = auditForm?.querySelector<HTMLElement>(".aol-hero__auditerr");
  const progress = auditForm?.querySelector<HTMLElement>(".aol-hero__progress");
  const bar = auditForm?.querySelector<HTMLElement>(".aol-meter");
  const fill = auditForm?.querySelector<HTMLElement>(".aol-meter__fill");
  const status = auditForm?.querySelector<HTMLElement>(".aol-hero__status");
  const report = document.querySelector<HTMLElement>(".aol-report");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // The guard is form + input ONLY.
  //
  // It used to require the progress bar, its fill, its status line and the
  // report section as well — so when the progress markup was accidentally
  // deleted, the listener never attached, the browser did a native GET submit,
  // and the page silently RELOADED on every attempt. A cosmetic dependency had
  // been made a functional one. Everything below is optional and null-checked
  // at the point of use; the form always submits.
  if (auditForm && auditInput) {
    const submit = auditForm.querySelector<HTMLButtonElement>(".aol-hero__auditgo")!;

    // Discrete through the crawl, time-based through scoring, capped until the
    // result actually lands.
    // MUST match the server's STEPS keys in functions/api/audit.ts. It was
    // missing "science", so the last step the server sends moved the bar not at
    // all — indexOf returned -1 and the branch was skipped in silence.
    const STEPS = ["wake", "home", "pricing", "studies", "sodont", "science"];
    // TYPICAL_S is what the tick-driven middle of the bar is calibrated
    // against. It was 120, from when a run scored twenty-three checks; a run is
    // now about ten seconds, so every heartbeat moved the fill by well under
    // one of the meter's ten cells and it sat visibly stuck.
    const FLOOR = 34, CEILING = 94, TYPICAL_S = 12;
    let pct = 0;
    const setPct = (n: number) => {
      pct = Math.max(pct, Math.min(100, n));
      // SNAP TO THE CELL. The meter draws ten cells, and a fill that stops
      // two-thirds of the way through one reads as a smooth bar wearing tick
      // marks rather than as a thing counting in steps. Rounding up means a
      // run that has started always shows at least one lit cell.
      const cells = Math.min(10, Math.ceil(pct / 10));
      if (fill) fill.style.width = `${cells * 10}%`;
      // ARIA carries the REAL number, not the snapped one — the rounding is a
      // visual convention and a screen reader should hear the actual progress.
      bar?.setAttribute("aria-valuenow", String(Math.round(pct)));
    };
    const say = (t: string) => { if (status) status.textContent = t; };

    const stop = (message?: string) => {
      auditForm.classList.remove("is-running");
      submit.disabled = false;
      if (message) say(message);
    };

    /**
     * Paint the report by CLONING DESIGN-SYSTEM MARKUP.
     *
     * The two <template> elements in AuditReport.astro hold real <SpecGrid> and
     * <Card> output, rendered by Astro at build time. Cloning them is what
     * keeps this in the system: the previous version wrote its own markup here
     * and invented `.aol-tile` and a bespoke masthead to style it, which is
     * exactly the drift that gets a report looking nothing like the site.
     *
     * Nothing below constructs a class name that a component does not already
     * emit.
     */
    /**
     * Paint the report by CLONING DESIGN-SYSTEM MARKUP.
     *
     * The two <template> elements in AuditReport.astro hold real <SpecGrid> and
     * <Card> output, rendered by Astro at build time. Cloning them is what
     * keeps this in the system; nothing below constructs a class name that a
     * component does not already emit.
     *
     * RESULTS FIRST. Three findings, then the offer. The version before this
     * led with a board of twenty verdicts and buried the three findings under
     * it — which put the least useful thing first and gave away the pass/fail
     * on every check we had paid to run.
     */
    /**
     * Paint the report by CLONING DESIGN-SYSTEM MARKUP.
     *
     * The <template> in AuditReport.astro holds real <Card> and <Badge> output,
     * rendered by Astro at build time. Cloning it is what keeps this in the
     * system; nothing below constructs a class name a component does not emit.
     *
     * THREE WINS, not three verdicts. Every card is a fix the reader can act on.
     */
    const render = (d: any) => {
      if (!report) return;
      const q = (sel: string) => report.querySelector<HTMLElement>(sel);
      const items = d.items ?? [];

      const host = q(".aol-report__host");
      if (host) host.textContent = d.host ?? "";

      // What the site already gets right. Shown only when there is something to
      // say, and never as a substitute for a win.
      const passing = q(".aol-report__passing");
      if (passing) {
        const ok: string[] = d.passing ?? [];
        if (ok.length) {
          passing.textContent = `Already doing this: ${ok.join(" · ")}`;
          passing.hidden = false;
        } else {
          passing.hidden = true;
        }
      }

      // The scope lives in the CTA line now, naming the areas rather than
      // tabulating them above it.
      // The scope lives in this line now. FOUR AREAS AT MOST: naming all six
      // turned the sentence into an inventory, and "…free trials, freemium, on
      // the call" does not read as English.
      const ctaTitle = q(".aol-report__ctatitle");
      if (ctaTitle) {
        const areas: string[] = (d.held ?? []).map((h: any) => String(h.short));
        const named = areas.slice(0, 4).join(", ");
        const more = areas.length > 4 ? " and more" : "";
        const scope = named ? `, including ${named}${more},` : "";
        ctaTitle.textContent = `${d.heldTotal ?? 0} more checks${scope} on the call.`;
      }

      const cap = q(".aol-report__cap");
      if (cap && Array.isArray(d.caps) && d.caps.length) {
        cap.textContent = d.caps[0];
        cap.hidden = false;
      }

      const wrap = q(".aol-report__findings");
      const cardTpl = document.querySelector<HTMLTemplateElement>("#tpl-audit-finding");
      if (wrap && cardTpl) {
        wrap.textContent = "";
        items.forEach((it: any, i: number) => {
          const card = cardTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
          const slot = (n: string) => card.querySelector<HTMLElement>(`[data-slot="${n}"]`);
          slot("n")!.textContent = `Win ${i + 1}`;
          slot("area")!.textContent = it.area ?? "";
          slot("title")!.textContent = it.name ?? "";
          slot("why")!.textContent = it.why ?? "";
          slot("found")!.textContent = it.observed ?? "";
          slot("cite")!.textContent = it.citation ?? "";
          wrap.appendChild(card);
        });
      }

      report.hidden = false;
      // Wait a frame: scrollIntoView on a section hidden a moment ago targets
      // where it used to be rather than where it now is.
      requestAnimationFrame(() =>
        report.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" }),
      );
    };

    const handle = (msg: any) => {
      if (msg.t === "open") say(`reading ${msg.host}…`);
      else if (msg.t === "step") {
        // `say` is the step written for a single line. The label+status pair is
        // the log's voice and collapses into nonsense when flattened.
        say(msg.say ?? msg.label.toLowerCase());
        const at = STEPS.indexOf(msg.key);
        if (at >= 0) setPct(((at + 1) / STEPS.length) * FLOOR);
      } else if (msg.t === "tick") {
        setPct(FLOOR + Math.min(1, msg.seconds / TYPICAL_S) * (CEILING - FLOOR));
        say(`still reading — ${msg.seconds}s`);
      } else if (msg.t === "need-url") {
        stop(msg.message);
      } else if (msg.t === "failed") {
        stop(msg.message);
      } else if (msg.t === "result") {
        setPct(100);
        stop("done");
        render(msg);
      }
    };

    const run = async (email: string) => {
      auditForm.classList.add("is-running");
      submit.disabled = true;
      if (progress) progress.hidden = false;
      setPct(2);
      say("connecting…");

      let res: Response;
      try {
        res = await fetch("/api/audit", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ email }),
        });
      } catch {
        stop("Couldn't reach the scorer. Check your connection and try again.");
        return;
      }

      // A non-OK reply must never be silent. astro dev answers 502 with an
      // EMPTY body and fetch does not throw on it — without this the bar sat
      // there and nothing else ever happened.
      const ctype = res.headers.get("content-type") ?? "";
      if (!res.ok || !/ndjson|json/i.test(ctype)) {
        stop(
          res.status === 502 || res.status === 404
            ? "The scorer isn't running. Locally: npx wrangler pages dev dist --port 8788"
            : `The scorer answered ${res.status}. Try again shortly, or just book the call.`,
        );
        return;
      }
      const reader = res.body?.getReader();
      if (!reader) { stop("The scorer sent an empty reply."); return; }

      const dec = new TextDecoder();
      let buf = "";
      const feed = (raw: string) => {
        if (!raw.trim()) return;
        try { handle(JSON.parse(raw)); } catch { /* a partial or junk line */ }
      };
      while (true) {
        const { value, done } = await reader.read();
        if (done) break;
        buf += dec.decode(value, { stream: true });
        const lines = buf.split("\n");
        buf = lines.pop() ?? "";
        for (const l of lines) feed(l);
      }
      // FLUSH THE TAIL: need-url and the validation failures are a single JSON
      // object with no trailing newline, so they live entirely in the buffer.
      buf += dec.decode();
      feed(buf);
    };

    /**
     * Demo mode — /?demo=1 replays a real captured run at a watchable pace.
     *
     * It exists because a live audit is ~30 seconds against real models and a
     * paid crawl, which makes the experience nearly impossible to review or
     * iterate on. It drives the SAME handlers as the live stream, so what you
     * watch here is what ships; only the source of the messages differs, and
     * the fixture is a genuine recorded run rather than invented copy.
     */
    const runDemo = async () => {
      auditForm.classList.add("is-running");
      submit.disabled = true;
      if (progress) progress.hidden = false;
      setPct(2);
      say("connecting…");
      let msgs: any[] = [];
      try {
        msgs = (await (await fetch("/audit-demo.json")).json()).stream ?? [];
      } catch {
        stop("Demo fixture missing.");
        return;
      }
      for (const m of msgs) {
        await new Promise((r) => setTimeout(r, reduce ? 0 : m.t === "result" ? 900 : 700));
        handle(m);
      }
    };

    if (new URLSearchParams(location.search).get("demo")) {
      auditInput.value = "someone@plausible.io";
      void runDemo();
    }

    auditForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const email = auditInput.value.trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        auditInput.classList.add("aol-control--error");
        auditInput.setAttribute("aria-invalid", "true");
        if (auditErr) { auditErr.textContent = "That doesn't look like an email address."; auditErr.hidden = false; }
        auditInput.focus();
        return;
      }
      auditInput.classList.remove("aol-control--error");
      auditInput.removeAttribute("aria-invalid");
      if (auditErr) auditErr.hidden = true;
      void run(email);
    });
    auditInput.addEventListener("input", () => {
      auditInput.classList.remove("aol-control--error");
      auditInput.removeAttribute("aria-invalid");
      if (auditErr) auditErr.hidden = true;
    });
  }

</script>
