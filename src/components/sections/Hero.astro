---
import { Button, DashedLine, Label, Panel } from "@andor/ds";
import { ArrowRight } from "lucide-react";
import { BOOKING_URL, HERO } from "@/data/site";

const facts = [
  { marker: 1, title: "Operator-led", body: "Led marketing and sales ops at Blockthrough (acquired by eyeo, 2022) and AdPushup (acquired by Geniee, 2023)." },
  { marker: 2, title: "Products in market", body: "MediaContext, market intelligence for the premium open web, is live with design partners." },
  { marker: 3, title: "Published in the trade", body: "Bylines in Digiday, ExchangeWire, eMarketer and the Forbes Communications Council." },
] as const;
---

<Panel>
  <section class="container pb-16 pt-32 md:pt-36 lg:pb-24 lg:pt-40" aria-labelledby="hero-title">
    <div class="grid gap-12 lg:grid-cols-[1.25fr_1fr] lg:gap-16">
      <div>
        <Label marker={1}>{HERO.label}</Label>
        <h1 id="hero-title" class="mt-6 max-w-[16ch] text-[2.5rem] font-semibold leading-[1.04] tracking-[-0.035em] md:text-6xl lg:text-[4.25rem]">
          {HERO.title}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground md:text-xl">{HERO.lede}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href={BOOKING_URL} target="_blank" rel="noopener noreferrer" size="lg">Book a call</Button>
          <Button href="#what-we-do" size="lg" variant="outline">What we do <ArrowRight /></Button>
        </div>
      </div>

      <ul class="relative flex flex-col justify-center gap-7 max-lg:pt-10 lg:pl-12">
        <DashedLine orientation="vertical" className="absolute left-0 top-0 max-lg:hidden" />
        <DashedLine className="absolute top-0 lg:hidden" />
        {facts.map((f) => (
          <li class="flex gap-4">
            <span class="mt-2 size-1.5 shrink-0" style={`background:var(--marker-${f.marker})`} aria-hidden="true" />
            <div>
              <h2 class="text-base font-semibold tracking-[-0.01em]">{f.title}</h2>
              <p class="mt-1 max-w-sm text-[15px] leading-relaxed text-muted-foreground">{f.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Panel>
