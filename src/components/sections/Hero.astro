---
import { Button, Label, Panel } from "@andor/ds";
import { ArrowRight } from "lucide-react";
import { BOOKING_URL, HERO } from "@/data/site";
---

<Panel>
  <section class="container pb-16 pt-32 md:pt-40 lg:pb-20 lg:pt-44" aria-labelledby="hero-title">
    <Label marker={1}>{HERO.label}</Label>
    <h1 id="hero-title" class="mt-6 max-w-[15ch] text-[2.5rem] font-semibold leading-[1.04] tracking-[-0.035em] md:text-6xl lg:text-7xl">
      {HERO.title}
    </h1>
    <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted-foreground md:text-xl">{HERO.lede}</p>
    <div class="mt-9 flex flex-wrap gap-3">
      <Button href={BOOKING_URL} target="_blank" rel="noopener noreferrer" size="lg">Book a call</Button>
      <Button href="#what-we-do" size="lg" variant="outline">What we do <ArrowRight /></Button>
    </div>
  </section>
</Panel>
