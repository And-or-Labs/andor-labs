---
import Link from "../ds/Link.astro";
import { BOOKING_URL, ICP_STARTUPS } from "../../config";

const faqs: [string, string][] = [
  ["How is this different from a typical marketing agency?", "Agencies staff you with a junior account team and run the same playbook. Here you work directly with an operator who has taken two startups through exits. The work spans the whole GTM rather than one slice of it."],
  ["Which engagement should I start with?", "It depends on the stage you are at. GTM Advisor at $1,000/mo plus equity if you are pre-seed and still sharpening the pitch for investors. Modernization Sprint at $10,000 if the product is further along than the brand. Fractional CMO at $5,000/mo once you have product-market fit signals and need someone to own the roadmap. If none of those obviously fit, book a call and we will figure it out on the call."],
  ["How quickly will we see results?", "The Modernization Sprint ships a new site and refreshed positioning in weeks. Advisory work runs on a monthly cadence and compounds from there. The Fractional CMO engagement carries a three-month minimum because pipeline built faster than that is usually borrowed rather than earned."],
  // The answer names adtech on purpose even though the ICP no longer does. The
  // track record is a fact about where it was earned, not a statement of who we
  // sell to, and hedging it into "technology" would trade a specific credential
  // for a vague one. Widening the ICP widens who we work with; it does not
  // retroactively move where the experience came from.
  [`Do you only work with ${ICP_STARTUPS}?`, "The operator track record was earned in adtech — a technically literate buyer, hard to impress, quick to spot a bluff. That transfers to most technical categories, and plenty of adjacent ones work fine too. Book a call and you will get an honest read on fit before anyone signs anything."],
  ["Who will I actually be working with?", "The founder, directly. No account layers and no handoff once the pitch is over. The person auditing your funnel is the same person who ran product marketing and sales operations through two exits above $100M."],
];
---
<!-- Grid. This is the last section before the warm footer, and the blog strip
     directly above it is white, so the alternation lands here on grid — the
     same slot RecentStories occupied before the two swapped places. -->
<section id="faq" style="border-bottom:1px solid var(--ink-200);background:var(--paper)">
  <div class="aol-faq-section" style="max-width:var(--container-width);margin:0 auto;padding:var(--section-pad-y) var(--gutter)">
    <header class="aol-faq-heading">
      <div class="aol-eyebrow" style="margin-bottom:14px">ICYMI</div>
      <h2 class="aol-display" style="font-size:40px;margin:0 0 16px">Frequently asked questions</h2>
      <p class="aol-faq-lead">Still unsure where you'd start? Most founders begin with the GTM Advisor.</p>
      <Link arrow href={BOOKING_URL} target="_blank" rel="noopener">Book a call</Link>
    </header>

    <div class="faq-open-grid">
        {faqs.map(([q, a], i) => (
          <article class="faq-open-item">
            <div class="faq-q">
              <span class="faq-idx">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="faq-text">{q}</h3>
            </div>
            <p class="faq-a">{a}</p>
          </article>
        ))}
    </div>
  </div>
</section>
