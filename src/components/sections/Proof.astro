---
import { Label } from "@andor/ds";
import { FOUNDER, PARTNERS, PRESS, TESTIMONIALS } from "@/data/site";
---

<section id="proof" class="border-t py-20 lg:py-28" aria-labelledby="proof-title">
  <div class="container">
    <a href={FOUNDER.linkedin} target="_blank" rel="noopener noreferrer" class="group flex max-w-3xl items-center gap-5">
      <img src={FOUNDER.photo} alt={FOUNDER.name} width="64" height="64" loading="lazy" class="size-16 shrink-0 rounded-2xl object-cover shadow-[0_0_0_1px_var(--border)]" />
      <h2 id="proof-title" class="text-xl font-semibold leading-snug tracking-[-0.02em] md:text-2xl">
        {FOUNDER.line}
      </h2>
    </a>

    <ul class="mt-14 grid gap-4 md:grid-cols-3">
      {TESTIMONIALS.map((t) => (
        <li class="flex flex-col justify-between gap-6 rounded-2xl bg-card p-6 shadow-[0_0_0_1px_var(--border)]">
          <blockquote class="text-[15px] leading-relaxed">“{t.quote}”</blockquote>
          <p class="flex items-center gap-3 text-sm leading-tight">
            {t.headshot
              ? <img src={t.headshot} alt="" width="36" height="36" loading="lazy" class="size-9 rounded-full object-cover shadow-[0_0_0_1px_var(--border)]" />
              : <span aria-hidden="true" class="grid size-9 place-items-center rounded-full bg-muted font-label text-[11px] text-muted-foreground">{t.author.split(" ").map((w) => w[0]).join("")}</span>}
            <span><span class="block font-medium">{t.author}</span><span class="text-muted-foreground">{t.role}</span></span>
          </p>
        </li>
      ))}
    </ul>

    <div class="mt-14 grid gap-8 border-t pt-8 md:grid-cols-[10rem_1fr] md:items-center">
      <Label>Launch partners</Label>
      <ul class="flex flex-wrap items-center gap-x-10 gap-y-5">
        {PARTNERS.map((p) => (
          <li class="flex items-center"><img src={p.src} alt={p.name} style={`height:${p.h}px;width:auto`} loading="lazy" class="max-w-none opacity-55 grayscale" /></li>
        ))}
      </ul>
      <Label>Bylines and press</Label>
      <ul class="flex flex-wrap gap-x-8 gap-y-2 text-[15px] font-medium text-muted-foreground">
        {PRESS.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </div>
</section>
