---
/**
 * The report.
 *
 * BUILT FROM DESIGN-SYSTEM COMPONENTS, not from classes typed to look like
 * them. That distinction is the whole point of this file's shape.
 *
 * The report is rendered on the client — the data arrives over a stream, so
 * there is no server pass in which to call <Card> per finding. The previous
 * version answered that by hand-writing markup in JS and inventing `.aol-tile`,
 * `.aol-finding` and a bespoke masthead, which drifted from the system
 * immediately and looked it.
 *
 * The answer is <template>. Astro renders the real components INTO the
 * templates below at build time, and the client clones them. The markup a
 * visitor sees is emitted by Card, Badge and SpecGrid themselves, so it cannot
 * drift from the system: change the component and this changes with it.
 *
 * WHAT THE SYSTEM PROVIDES, and what each part uses:
 *
 *   Badge     the grade, beside the host — a label, which is what a grade is
 *   SpecGrid  the checks — a leader-dot datasheet. Its own note says rows of
 *             facts read as a technical figure "where identical stat tiles
 *             would read as filler", which is exactly what the tile board was
 *   Card      each opened finding
 *   Button    the booking CTA
 *
 * A FINDING CARD CARRIES FOUR THINGS AND NOTHING ELSE: what was checked, why
 * it matters, what we found here, and the paper it comes from. The version
 * before this also showed a code, an area label and a headline statistic, and
 * the card stopped being readable as a finding.
 */
import Badge from "../ds/Badge.astro";
import Button from "../ds/Button.astro";
import Card from "../ds/Card.astro";
import SpecGrid from "../ds/SpecGrid.astro";
import { BOOKING_URL } from "../../config";
---

<section class="aol-report" id="audit-report" aria-labelledby="audit-report-title" hidden>
  <div class="aol-report__inner">

    {/* The grade is a LABEL beside the name, not a headline of its own. */}
    <header class="aol-report__top">
      <h2 class="aol-report__host" id="audit-report-title"></h2>
      <Badge variant="outline" class="aol-report__grade"></Badge>
      <p class="aol-report__count"></p>
    </header>

    <p class="aol-report__cap" hidden></p>

    {/* Every check that ran, in the order the research publishes them. */}
    <div class="aol-report__board"></div>

    {/* The failures worth acting on. */}
    <div class="aol-report__findings"></div>

    <Card variant="sunken" padding="lg" class="aol-report__cta">
      <h3 class="aol-report__ctatitle"></h3>
      <Button variant="primary" arrow href={BOOKING_URL} target="_blank" rel="noopener">Book a call</Button>
    </Card>
  </div>

  {/*
    TEMPLATES. Real components, rendered by Astro, cloned by the client.

    Nothing in here is displayed: <template> content is inert and never
    rendered. It exists so the client has genuine design-system markup to copy
    instead of building its own out of strings.
  */}
  <template id="tpl-audit-checks">
    <SpecGrid specs={[{ label: "", value: "" }]} class="aol-report__checks" />
  </template>

  <template id="tpl-audit-finding">
    <Card variant="flat" padding="md" class="aol-finding">
      <div class="aol-finding__top">
        <h4 class="aol-finding__title" data-slot="title"></h4>
        <Badge variant="danger" class="aol-finding__verdict" data-slot="verdict"></Badge>
      </div>
      <p class="aol-finding__why" data-slot="why"></p>
      <p class="aol-finding__found" data-slot="found"></p>
      <p class="aol-finding__cite" data-slot="cite"></p>
    </Card>
  </template>
</section>
