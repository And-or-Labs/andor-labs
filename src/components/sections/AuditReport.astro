---
/**
 * The report.
 *
 * Three bands, in the order a reader wants them:
 *
 *   1. THE VERDICT — host, grade, and the two numbers that matter.
 *   2. THE BOARD   — every check as a PASS/FAIL tile, filling the width. This
 *                    is the scannable layer: you find your failures at a glance
 *                    rather than by reading seventeen rows of prose.
 *   3. THE OPEN THREE — the failures worth acting on, at full size.
 *
 * The board and the findings are separated deliberately. They answer different
 * questions — "how did I do" and "what do I fix" — and the previous version
 * interleaved them, so the answer to the first was buried inside the second and
 * neither was scannable.
 *
 * Every check shows its verdict, including the withheld ones. Only the EVIDENCE
 * is gated. Hiding the verdict too left a column of dashes that told a reader
 * nothing about their own site; showing pass/fail for all of them is both the
 * more useful page and the stronger tease.
 *
 * No throat-clearing. Nothing here explains what the section is, apologises for
 * the gate, or thanks anyone for their time.
 */
import { BOOKING_URL } from "../../config";
---

<section class="aol-report" id="audit-report" aria-labelledby="audit-report-title" hidden>
  <div class="aol-report__inner">

    <header class="aol-report__top">
      <div>
        <h2 class="aol-report__host" id="audit-report-title"></h2>
        <p class="aol-report__grade"></p>
      </div>
      <div class="aol-report__tally">
        <span class="aol-report__tallyitem aol-report__tallyitem--pass"><b></b> passed</span>
        <span class="aol-report__tallyitem aol-report__tallyitem--fail"><b></b> failed</span>
      </div>
    </header>

    <p class="aol-report__cap" hidden></p>

    {/* The board — every check, in the order the research publishes them. */}
    <div class="aol-report__board"></div>

    {/* The failures worth acting on. */}
    <div class="aol-report__findings"></div>

    <div class="aol-report__cta">
      <h3 class="aol-report__ctatitle"></h3>
      <a class="aol-report__ctabtn" href={BOOKING_URL} target="_blank" rel="noopener">Book a call</a>
    </div>
  </div>
</section>
