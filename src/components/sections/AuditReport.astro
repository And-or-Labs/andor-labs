---
/**
 * The report — a tractor-feed printout, below the hero.
 *
 * Direction C from the design system's own scorecard exploration
 * (explorations/scorecard-directions.html), built to its conventions rather
 * than approximated: sprocket margins down both edges, a mono masthead, a
 * mono masthead, rows whose bodies are serif, and unpunched holes where a withheld row's
 * evidence would be.
 *
 * The exploration's plotted meter is deliberately NOT here. It listed all
 * twenty codes above a list of the same twenty codes — a summary is only a
 * summary if it says something the detail does not, and with most rows
 * withheld it plotted as twenty near-empty bars. The unpunched strips already
 * carry the shape.
 *
 * EVERY CHECK IS LISTED, IN THE ORDER THE RESEARCH PUBLISHES THEM. Three are
 * open where they actually fall. The rest show only a code — BRAND-1,
 * PRICING-3 — which is a stronger gate than a name, because a name is most of
 * the finding while a code is only a position.
 *
 * Each open row carries the finding, the MECHANISM behind the rule, the
 * study's own number where one exists, and the paper. A verdict without a
 * mechanism is an assertion; the number is what makes it worth acting on.
 */
import { BOOKING_URL } from "../../config";
---

<section class="aol-report" id="audit-report" aria-labelledby="audit-report-title" hidden>
  <div class="aol-report__inner">
    <div class="aol-report__paper">
      <div class="aol-report__masthead">
        <div>
          <span class="aol-eyebrow">GTM scorecard</span>
          <h2 class="aol-report__host" id="audit-report-title"></h2>
          <p class="aol-report__meta"></p>
        </div>
        <div class="aol-report__grade">
          <span class="aol-report__letter"></span>
          <span class="aol-report__gradelabel"></span>
        </div>
      </div>

      <p class="aol-report__cap" hidden></p>

      <div class="aol-report__rows"></div>

      <p class="aol-report__stamp"></p>

      <div class="aol-report__foot">
        <div>
          <h3 class="aol-report__foottitle"></h3>
          <p>
            Thirty minutes, no deck. We go through every check on the card and you
            keep the notes either way.
          </p>
        </div>
        <div>
          <a class="aol-report__ctabtn" href={BOOKING_URL} target="_blank" rel="noopener">Book a call</a>
          <span class="aol-report__ctanote">30 min · no deck</span>
        </div>
      </div>
    </div>
  </div>
</section>
