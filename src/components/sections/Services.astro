---
import { Button, Label, SectionHeader } from "@andor/ds";
import { BarChart3, Check, Compass, FileText, Megaphone, Workflow } from "lucide-react";
import { BOOKING_URL, CAPABILITIES, OFFERS } from "@/data/site";

const icons = [Compass, BarChart3, FileText, Megaphone, Workflow];
---

<section id="services" class="container py-20 lg:py-28" aria-labelledby="services-title">
  <SectionHeader id="services-title" label="Services" marker={1} title="Choose the right GTM support for your stage" lede="We blend operator judgment with AI speed." />

  <ul class="mt-12 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-5">
    {CAPABILITIES.map((c, i) => {
      const Icon = icons[i];
      return (
        <li>
          <span class="grid size-9 place-items-center rounded-lg bg-muted text-foreground shadow-[0_0_0_1px_var(--border)]"><Icon className="size-4" /></span>
          <h3 class="mt-4 text-[15px] font-semibold tracking-[-0.01em]">{c.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{c.body}</p>
        </li>
      );
    })}
  </ul>

  <div class="mt-16 grid gap-4 lg:grid-cols-3">
    {OFFERS.map((o) => (
      <article class:list={["relative flex flex-col rounded-2xl p-7 md:p-8", o.featured ? "bg-card shadow-[0_0_0_1.5px_var(--primary),var(--shadow-panel)]" : "bg-card shadow-[0_0_0_1px_var(--border)]"]}>
        <Label marker={1}>{o.kind}</Label>
        <h3 class="mt-4 text-xl font-semibold tracking-[-0.02em]">{o.name}</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">{o.blurb}</p>
        <p class="mt-6 flex items-baseline gap-2">
          <span class="text-3xl font-semibold tracking-[-0.03em] tabular-nums">{o.price}</span>
          <span class="text-sm text-muted-foreground">{o.per}</span>
        </p>
        <ul class="mt-6 grid gap-2.5 border-t pt-6">
          {o.feats.map((f) => (
            <li class="flex items-start gap-2.5 text-[15px]"><Check className="mt-0.5 size-4 shrink-0 text-primary" />{f}</li>
          ))}
        </ul>
        <Button href={BOOKING_URL} target="_blank" rel="noopener noreferrer" variant={o.featured ? "default" : "outline"} className="mt-8 w-full">{o.cta}</Button>
      </article>
    ))}
  </div>

  <p class="mt-8 text-center text-[15px] text-muted-foreground">
    Have a custom project? <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="font-medium text-foreground underline decoration-border underline-offset-4 transition-colors hover:decoration-foreground">Book a call</a>
  </p>
</section>
