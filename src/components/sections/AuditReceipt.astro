---
/**
 * The receipt — the audit's result, printed directly below the hero.
 *
 * Hidden until there is something to print. The hero runs the audit in place
 * (progress bar under the email field) and when the result lands this section
 * fills in and the page scrolls to it.
 *
 * WHY BELOW THE HERO rather than on its own page. The wait is the problem a
 * lead magnet has to solve, and a navigation makes it worse: it throws away the
 * context the visitor just read and replaces it with a loading screen. Staying
 * put means the promise is still on screen while the machine works, and the
 * answer arrives under it as the next thing to read rather than as a
 * destination.
 *
 * Tractor-feed variant C3 from the design system's scorecard exploration. It
 * was right in a modal, wrong on a full page — and it is right again here,
 * because a receipt is exactly the shape of a short gated preview sitting in a
 * page's flow. The full breakdown is what the call is for.
 */
import { BOOKING_URL } from "../../config";
---

<section class="aol-receipt" id="audit-receipt" aria-labelledby="audit-receipt-title" hidden>
  <div class="aol-receipt__inner">
    <div class="aol-roll">
      <div class="aol-roll__head">
        <span class="aol-roll__eyebrow">GTM scorecard</span>
        <span class="aol-roll__host"></span>
      </div>

      <div class="aol-roll__grade">
        <span class="aol-roll__letter"></span>
        <span class="aol-roll__label" id="audit-receipt-title"></span>
      </div>

      <p class="aol-roll__cap" hidden></p>
      <p class="aol-roll__meta"></p>

      <div class="aol-roll__rule" aria-hidden="true"></div>

      {/* One row per check. Not summaries — each carries its own score, its own
          evidence quoting the page, and the peer-reviewed paper behind it. */}
      <div class="aol-roll__findings"></div>

      <div class="aol-roll__rule" aria-hidden="true"></div>

      {/* The gate. Names and bars only: the server never sent evidence, a score
          or a citation for these, so there is nothing here to reveal. */}
      <div class="aol-roll__locked"></div>

      <div class="aol-roll__coupon">
        <h2 class="aol-roll__ctatitle"></h2>
        <p class="aol-roll__ctabody">
          Thirty minutes, no deck. We go through every check on the card and you
          keep the notes either way.
        </p>
        <a class="aol-roll__cta" href={BOOKING_URL} target="_blank" rel="noopener">Book a call</a>
        <span class="aol-roll__note">30 min · no deck</span>
      </div>
    </div>
  </div>
</section>
