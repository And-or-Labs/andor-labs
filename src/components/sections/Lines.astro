---
import { Label } from "@andor/ds";
import { ArrowRight, ArrowUpRight } from "lucide-react";
import { LINES } from "@/data/site";

const { product, services, writing } = LINES;
const side = [
  { ...services, marker: 1 as const, external: true },
  { ...writing, marker: 3 as const, external: false },
];
---

<section id="what-we-do" class="container pb-20 pt-4 lg:pb-28" aria-label="What we do">
  <div class="grid gap-4 lg:grid-cols-[1.6fr_1fr]">
    <a
      href={product.href}
      target="_blank"
      rel="noopener noreferrer"
      class="group relative flex flex-col overflow-hidden rounded-2xl bg-card shadow-[0_0_0_1px_var(--border)] transition-shadow hover:shadow-[0_0_0_1px_var(--border),var(--shadow-panel)] lg:row-span-2"
    >
      <div class="flex items-start justify-between gap-6 p-7 pb-0 md:p-8 md:pb-0">
        <div>
          <Label marker={2}>{product.label}</Label>
          <h2 class="mt-4 text-2xl font-semibold tracking-[-0.025em]">{product.name}</h2>
          <p class="mt-2 max-w-md text-[15px] leading-relaxed text-muted-foreground">{product.body}</p>
          <p class="mt-3 font-label text-[11px] uppercase tracking-[0.08em] text-muted-foreground">{product.note}</p>
        </div>
        <span class="inline-flex shrink-0 items-center gap-1 text-sm font-medium max-sm:hidden">
          mediacontext.dev <ArrowUpRight className="size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
        </span>
      </div>
      <div class="relative mt-8 ml-7 min-h-64 flex-1 overflow-hidden rounded-tl-xl shadow-[-1px_-1px_0_var(--border)] md:ml-8 [mask-image:linear-gradient(to_bottom,#000_60%,transparent),linear-gradient(to_right,#000_80%,transparent)] [mask-composite:intersect]">
        <img src={product.image} alt={product.alt} width="2880" height="1800" decoding="async" class="absolute left-0 top-0 w-[900px] max-w-none transition-transform duration-500 ease-out-brand group-hover:-translate-x-2 group-hover:-translate-y-1 lg:w-[1100px]" />
      </div>
    </a>

    {side.map((l) => (
      <a href={l.href} {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})} class="group flex flex-col justify-between gap-8 rounded-2xl bg-card p-7 shadow-[0_0_0_1px_var(--border)] transition-shadow hover:shadow-[0_0_0_1px_var(--border),var(--shadow-panel)] md:p-8">
        <div>
          <Label marker={l.marker}>{l.label}</Label>
          <h2 class="mt-4 text-2xl font-semibold tracking-[-0.025em]">{l.name}</h2>
          <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">{l.body}</p>
        </div>
        <span class="inline-flex items-center gap-1.5 text-sm font-medium">
          {l.cta} <ArrowRight className="size-4 transition-transform group-hover:translate-x-0.5" />
        </span>
      </a>
    ))}
  </div>
</section>
