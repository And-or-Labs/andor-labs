---
import Logo from "../ds/Logo.astro";
import Button from "../ds/Button.astro";
import { BOOKING_URL } from "../../config";

// Homepage anchors are absolute (`/#id`) rather than relative (`#id`) so they
// still resolve correctly from /blog and /work pages, not just from `/`.
//
// "Work" is deliberately NOT in the nav. It pointed straight at the single live
// case study, which advertised the thinness rather than the work — a nav item
// that lands on one example reads as a section that ran out. /work/filament is
// still live, still in the sitemap, and still linked from the case study's own
// surfaces; it just does not get top-level billing until there are a few.
const NAV: [string, string][] = [
  // Order tracks the page order (founder → what we do → pricing → compare → FAQ),
  // with the two off-homepage destinations last, since they leave the page
  // rather than scrolling within it.
  //
  // Tools earned its billing under the same rule that keeps Work out: an index
  // is worth a nav slot once it lands on more than one thing.
  //
  // As of 2026-08-21 it lands on nothing — Subreddit Scout was retired and Rank
  // My AdTech went back to WIP — so the same rule takes the slot away again.
  // /tools/ still resolves for anyone holding the link; it is just not
  // advertised, and it is out of the sitemap. Restore this line, the footer's,
  // and the sitemap filter together when something ships there.
  // See docs/WIP-rank-my-adtech.md.
  ["About", "/#founder"],
  ["Pricing", "/#how-we-work"],
  ["Why us", "/#compare"],
  ["FAQ", "/#faq"],
  ["Blog", "/blog/"],
];
---
{/* Paper, translucent, over the fine grid mesh.

    The tint that was here briefly is gone: on the mesh it read as pink rather
    than as paper, and the mesh is the thing doing the work. --paper at 88%
    keeps the bar translucent so the page moves under it, and the blur keeps
    what shows through from competing with the nav.

    color-mix rather than a literal rgba: the translucency and the blur are the
    point of a sticky bar, and hardcoding rgba(255,255,255,.88) would freeze the
    token's value into the markup.

    The hairline is --ink-200 again. --border-warm is the hairline drawn ON a
    warm surface, and this is not one any more.

    The mesh is .aol-grid-blue — the same 3x3px tile with a 1px blue tick at 15%
    that #what-we-do, #compare and #faq already stand on, so the chrome joins
    the grid the page is built on rather than getting a texture of its own.

    It is applied as a CLASS with the ground left inline as background-COLOR.
    The `background` shorthand would reset background-image to none and silently
    drop the mesh, and the header would look exactly as it did before. */}
<header class="aol-grid-blue" style="position:sticky;top:0;z-index:20;background-color:color-mix(in srgb, var(--paper) 88%, transparent);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border-bottom:1px solid var(--ink-200)">
  <div style="max-width:var(--container-width);margin:0 auto;padding:var(--space-4) var(--gutter);display:flex;align-items:center;justify-content:space-between">
    <a href="/" style="text-decoration:none;display:inline-flex;align-items:center;gap:9px">
      <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true" style="display:block;flex:none"><rect width="32" height="32" rx="4" fill="#1B4DFF"/><path d="M20.75 8 L11.25 24" stroke="#fff" stroke-width="3.25" stroke-linecap="round"/></svg>
      <Logo size="md" />
    </a>
    <nav style="display:flex;gap:26px;align-items:center">
      {NAV.map(([label, href]) => (
        <a class="site-nav-link" href={href}>{label}</a>
      ))}
      {/* The chrome keeps the booking, and the HERO carries the audit.
          That split is deliberate: the two asks are different commitments and
          they belong at different distances. A visitor who already knows they
          want to talk should not have to scroll to find the booking, and a
          visitor who does not should meet the free audit next to the promise
          that earns it — not in a 172px slot wedged between the nav and the
          menu button, which is where it briefly lived and never fitted.
          See .aol-hero__auditform in Hero.astro. */}
      <Button size="sm" variant="primary" arrow href={BOOKING_URL} target="_blank" rel="noopener" class="site-header-cta">Book a call</Button>
      <button type="button" class="site-nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </nav>
  </div>
  <nav id="mobile-menu" class="site-mobilemenu" aria-label="Sections">
    {NAV.map(([label, href]) => (
      <a class="site-mobilelink" href={href}>{label}</a>
    ))}
    <div class="site-mobilecta">
      <Button variant="primary" size="md" fullWidth arrow href={BOOKING_URL} target="_blank" rel="noopener">Book a call</Button>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("header");
  const toggle = header?.querySelector<HTMLButtonElement>(".site-nav-toggle");
  const menu = header?.querySelector<HTMLElement>("#mobile-menu");
  if (header && toggle && menu) {
    const setOpen = (open: boolean) => {
      header.classList.toggle("nav-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };
    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") setOpen(false); });
    document.addEventListener("click", (e) => {
      if (header.classList.contains("nav-open") && !header.contains(e.target as Node)) setOpen(false);
    });
    // Close the menu if the viewport grows past the mobile breakpoint.
    matchMedia("(min-width: 561px)").addEventListener("change", (e) => { if (e.matches) setOpen(false); });
  }


</script>
