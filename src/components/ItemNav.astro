---
import { MENU, tone } from "../data/site";
interface Props { current: number; }
const { current } = Astro.props;
---
<nav class="itemnav" aria-label="Lines of work">
  {MENU.map(m => (
    <a href={m.href} data-menu-key={m.n} aria-current={m.n === current ? "page" : undefined} style={tone(m.color)}>
      <span class="br">[{m.n}]</span> {m.label}
    </a>
  ))}
</nav>

<style>
  .itemnav { margin-top: auto; padding-top: clamp(24px, 5vh, 48px); display: flex; flex-wrap: wrap; gap: 2px 4px; }
  .itemnav a { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 10px; font: 12px var(--mono); letter-spacing: .04em; color: var(--dim); text-decoration: none; transition: background-color .2s var(--ease), color .2s var(--ease); }
  .itemnav a:hover { color: var(--ink); background: color-mix(in oklab, var(--c) 10%, transparent); }
  .itemnav .br { color: var(--faint); }
  .itemnav a:hover .br, .itemnav a[aria-current] .br { color: var(--ct, var(--c)); }
  .itemnav a[aria-current] { color: var(--ink); box-shadow: inset 0 -2px 0 var(--c); }
  /* Phones: a plain four-row index, one thumb-sized row per line of work. */
  @media (max-width: 860px) {
    .itemnav { display: grid; gap: 0; margin-top: 44px; padding-top: 0; border-top: 1px solid var(--guide-2, var(--rule)); }
    .itemnav a { min-height: 48px; padding: 0 4px; border-bottom: 1px solid var(--guide-2, var(--rule)); transition: background-color .2s var(--ease), color .2s var(--ease), padding .2s var(--ease); }
    .itemnav a[aria-current] { padding-left: 12px; box-shadow: inset 2px 0 0 var(--c); background: color-mix(in oklab, var(--c) 6%, transparent); }
  }
  @media (min-width: 1100px) { .itemnav { display: none; } }
</style>
