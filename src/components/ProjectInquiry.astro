---
import { BOOKING_URL, EMAIL, GTM } from "../data/site";
---
<form class="project-form" action={BOOKING_URL} method="get" data-project-inquiry>
  <p class="evidence-note">A little context, then pick a time. All fields are required.</p>
  <label for="project-company">Company or website</label>
  <input id="project-company" name="company" type="text" autocomplete="organization" maxlength="200" required />
  <label for="project-problem">What needs to change?</label>
  <textarea id="project-problem" name="notes" rows="3" maxlength="1200" required></textarea>
  <label for="project-timing">When would you like to start?</label>
  <select id="project-timing" name="timing" required>
    <option value="">Choose a timeframe</option>
    <option>As soon as possible</option>
    <option>Within a month</option>
    <option>In the next three months</option>
    <option>Exploring for later</option>
  </select>
  <label for="project-engagement">Engagement</label>
  <select id="project-engagement" name="engagement" required>
    <option value="">Choose an engagement</option>
    {GTM.offers.map(o => <option>{o.name}</option>)}
    <option>Help me choose</option>
  </select>
  <button class="btn primary" type="submit">Continue to booking <span aria-hidden="true">↗</span></button>
  <p class="evidence-note">Your project details will accompany your booking.</p>
  <noscript><p>Please include your company, timing, and preferred engagement in the project description above so they accompany your booking.</p></noscript>
  <a class="text-link" href={`mailto:${EMAIL}`}>Prefer email? {EMAIL}</a>
</form>
<script>
  function wireProjectInquiry() {
    const form = document.querySelector<HTMLFormElement>("[data-project-inquiry]");
    if (!form || form.dataset.ready) return;
    form.dataset.ready = "true";
    form.addEventListener("submit", event => {
      event.preventDefault();
      const data = new FormData(form);
      const notes = [
        `Company / website: ${String(data.get("company") ?? "").trim()}`,
        `Project: ${String(data.get("notes") ?? "").trim()}`,
        `Timing: ${data.get("timing")}`,
        `Engagement: ${data.get("engagement")}`,
      ].join("\n\n");
      const url = new URL(form.action);
      url.searchParams.set("notes", notes);
      window.location.assign(url.href);
    });
    document.querySelectorAll<HTMLAnchorElement>("[data-offer]").forEach(link => {
      link.addEventListener("click", () => {
        const select = form.querySelector<HTMLSelectElement>("[name=engagement]");
        if (select) select.value = link.dataset.offer ?? "";
        form.querySelector<HTMLInputElement>("input")?.focus({ preventScroll: true });
      });
    });
  }
  document.addEventListener("astro:page-load", wireProjectInquiry);
</script>
