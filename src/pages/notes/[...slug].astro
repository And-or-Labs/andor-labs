---
import { getCollection, render } from "astro:content";

import Crumb from "../../components/Crumb.astro";
import Icon from "../../components/Icon.astro";
import ItemNav from "../../components/ItemNav.astro";
import Section from "../../components/Section.astro";
import Subscribe from "../../components/Subscribe.astro";
import { SITE } from "../../data/site";
import Sheet from "../../layouts/Sheet.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", p => !p.data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }));
}
const { post, newer, older } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const d = post.data;
const url = new URL(`/notes/${post.id}/`, SITE.url).toString();
const enc = encodeURIComponent;
const minutes = remarkPluginFrontmatter?.minutes ?? Math.max(1, Math.round((post.body ?? "").split(/\s+/).length / 230));
const fmt = (x: Date) => x.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---
<Sheet title={d.title} description={d.description} fig="log" color="butter" image={d.heroImage} type="article" publishedTime={d.pubDate}>
  <Crumb slot="crumb" href="/notes/" label="Field notes" />
  <article>
    <p class="eyebrow"><span class="br">[4]</span> Field notes</p>
    <h1 class="title">{d.title}</h1>
    {d.standfirst && <p class="lede">{d.standfirst}</p>}
    <p class="post-meta"><time datetime={d.pubDate.toISOString()}>{fmt(d.pubDate)}</time><span>{minutes} min read</span><span>Vishveshwar Jatain</span></p>
    <div class="body">
      {d.heroImage && (
        <figure class="post-hero">
          <img src={d.heroImage} alt={d.heroAlt ?? ""} loading="eager" decoding="async" />
          {d.heroCredit && <figcaption>{d.heroCredit}</figcaption>}
        </figure>
      )}
      {d.keyTakeaways?.length ? (
        <aside class="card takeaways"><p class="label">Key takeaways</p><ul>{d.keyTakeaways.map(k => <li>{k}</li>)}</ul></aside>
      ) : null}
      <div class="prose"><Content /></div>
      <div class="share">
        <span class="label">Share</span>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`} target="_blank" rel="noopener" aria-label="Share on LinkedIn" title="LinkedIn"><Icon name="linkedin" /></a>
        <a href={`https://x.com/intent/post?url=${enc(url)}&text=${enc(d.title)}&via=eclecticV`} target="_blank" rel="noopener" aria-label="Share on X" title="X"><Icon name="x" /></a>
        <a href={`mailto:?subject=${enc(d.title)}&body=${enc(url)}`} aria-label="Share by email" title="Email"><Icon name="email" /></a>
        <button type="button" data-copy-link aria-label="Copy link" title="Copy link"><Icon name="link" /></button>
        <span class="copied" aria-live="polite"></span>
      </div>
      <Section id="next" label="Next step">
        <div class="card"><Subscribe source="blog-post" /></div>
      </Section>
      <nav class="pager" aria-label="More notes">
        {older ? <a href={`/notes/${older.id}/`}><span class="label">Older</span>{older.data.title}</a> : <span></span>}
        {newer ? <a href={`/notes/${newer.id}/`}><span class="label">Newer</span>{newer.data.title}</a> : <span></span>}
      </nav>
    </div>
  </article>
  <ItemNav current={4} />
</Sheet>
