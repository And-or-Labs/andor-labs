---
import { getCollection, render } from "astro:content";

import Post from "../../layouts/Post.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", p => !p.data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }));
}
const { post, newer, older } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const minutes = remarkPluginFrontmatter?.minutes ?? Math.max(1, Math.round((post.body ?? "").split(/\s+/).length / 230));
---
<Post post={post} newer={newer} older={older} minutes={minutes}><Content /></Post>
