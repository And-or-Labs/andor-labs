---
import { getCollection } from "astro:content";

import Crumb from "../../components/Crumb.astro";
import ItemNav from "../../components/ItemNav.astro";
import NotePreview from "../../components/NotePreview.astro";
import Section from "../../components/Section.astro";
import Subscribe from "../../components/Subscribe.astro";
import { EXPERIMENTS } from "../../data/site";
import Sheet from "../../layouts/Sheet.astro";
const posts = (await getCollection("blog", p => !p.data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const selectedExperiment = EXPERIMENTS.find(x => x.file === "DOOMSDAY.CLK")!;
const selectedPost = posts[0];
const moreExperiments = EXPERIMENTS.filter(x => x !== selectedExperiment);
const morePosts = posts.filter(p => p !== selectedPost);
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll("-", ".");
---
<Sheet title="Lab notes" description="Experiments and field notes on GTM, AI and the post-software era." fig="flask" color="green">
  <Crumb slot="crumb" />
  <p class="eyebrow"><span class="br">[3]</span> Lab notes</p>
  <h1 class="title">Things we built to see what happens.</h1>
  <p class="lede">Small, strange, working software. Some of it becomes product. Most of it becomes a note.</p>
  <div class="body notes-body">
    <Section id="selected" label="From the lab">
      <div class="selected-notes">
        <NotePreview
          id="selected-experiment"
          label="Selected experiment"
          title={selectedExperiment.name}
          description={selectedExperiment.body}
          href={selectedExperiment.href}
          cta={selectedExperiment.cta}
          external={selectedExperiment.external}
          image="/media/experiments/zero-click.webp"
          imageAlt="Zero-click doomsday clock showing search-referral history and forecasts for the News and Politics category."
          imageWidth={1440}
          imageHeight={900}
        />
        {selectedPost && <NotePreview
          id="selected-note"
          label="Selected field note"
          title={selectedPost.data.title}
          description={selectedPost.data.standfirst ?? selectedPost.data.description}
          href={`/notes/${selectedPost.id}/`}
          cta="Read the note"
          image={selectedPost.data.heroImage}
          imageAlt={selectedPost.data.heroAlt ?? ""}
          imageCredit={selectedPost.data.heroCredit}
          imageWidth={1600}
          imageHeight={900}
          date={selectedPost.data.pubDate}
        />}
      </div>
    </Section>

    <Section id="experiments" label="More experiments" count={moreExperiments.length}>
      {moreExperiments.map(x => (
        <article class="card">
          <p class="label c">{x.file}</p>
          <h3>{x.name}</h3>
          <p>{x.body}</p>
          <a class="text-link" href={x.href} {...(x.external ? { target: "_blank", rel: "noopener" } : { "data-astro-reload": true })}>{x.cta} <span aria-hidden="true">{x.external ? "↗" : "→"}</span></a>
        </article>
      ))}
      <p class="sec-foot"><a class="text-link" href="https://github.com/eclecticv" target="_blank" rel="noopener">More in the open on GitHub <span aria-hidden="true">↗</span></a></p>
    </Section>

    <Section id="notes" label="More field notes" count={morePosts.length}>
      <ol class="posts">
        {morePosts.map(p => <li><a href={`/notes/${p.id}/`}><time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time><span>{p.data.title}</span></a></li>)}
      </ol>
      <p class="sec-foot"><a class="text-link" href="/rss.xml">RSS feed</a></p>
    </Section>

    <Section id="next" label="Next step">
      <div class="card" id="subscribe"><Subscribe source="blog-index" /></div>
    </Section>
  </div>
  <ItemNav current={3} />
</Sheet>

<style>
  .notes-body { max-width: 56rem; }
  .selected-notes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 680px) {
    .selected-notes { grid-template-columns: minmax(0, 1fr); }
  }
</style>
