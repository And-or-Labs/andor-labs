---
import { getCollection } from "astro:content";

import NextNotes from "../../components/NextNotes.astro";
import Section from "../../components/Section.astro";
import { EXPERIMENTS } from "../../data/site";
import Page from "../../layouts/Page.astro";

const posts = (await getCollection("blog", p => !p.data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll("-", ".");
---
<Page
  n={3}
  heading="Things we built to see what happens."
  lede="Small, strange, working software. Some of it becomes product. Most of it becomes a note."
  description="Transmissions from And/or Labs on GTM, AI and the post-software era."
  spec={[
    { k: "Transmissions", v: `${posts.length}`, href: "#notes" },
    { k: "Experiments", v: `${EXPERIMENTS.length}`, href: "#experiments" },
    { k: "Podcast", v: "Slice of AdTech", href: "https://sliceofadtech.buzzsprout.com/2043731/episodes" },
    { k: "Feed", v: "RSS", href: "/rss.xml" },
  ]}
>
  <Section id="notes" label="Transmissions" count={posts.length}>
    <ol class="posts">
      {posts.map(p => <li><a href={`/notes/${p.id}/`}><time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time><span>{p.data.title}</span></a></li>)}
    </ol>
  </Section>
  <Section id="experiments" label="Experiments" count={EXPERIMENTS.length}>
    <ul class="list">
      {EXPERIMENTS.map(x => (
        <li><a href={x.href} {...(x.external ? { target: "_blank", rel: "noopener" } : { "data-astro-reload": true })}><span class="k">{x.file}</span><span class="v">{x.name}<span class="sub-v">{x.body}</span></span><span class="x" aria-hidden="true">{x.external ? "↗" : "→"}</span></a></li>
      ))}
    </ul>
    <p class="sec-foot"><a class="text-link" href="https://github.com/eclecticv" target="_blank" rel="noopener">More in the open on GitHub <span aria-hidden="true">↗</span></a></p>
  </Section>
  <NextNotes slot="next" source="blog-index" />
</Page>
