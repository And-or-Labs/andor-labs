---
import { getCollection } from "astro:content";

import Crumb from "../../components/Crumb.astro";
import ItemNav from "../../components/ItemNav.astro";
import Section from "../../components/Section.astro";
import Subscribe from "../../components/Subscribe.astro";
import { NOTES, PRESS } from "../../data/site";
import Sheet from "../../layouts/Sheet.astro";
const posts = (await getCollection("blog", p => !p.data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll("-", ".");
const ext = { target: "_blank", rel: "noopener" };
---
<Sheet title="Writing" description="Field notes, bylines and coverage in Digiday, Adweek, AdExchanger, ExchangeWire, eMarketer and others." fig="notes" color="lilac">
  <Crumb slot="crumb" />
  <p class="eyebrow"><span class="br">[3]</span> Writing</p>
  <h1 class="title">{NOTES.title}</h1>
  <p class="lede">{NOTES.lede}</p>
  <div class="body">
    <div class="card"><Subscribe source="blog-index" /></div>

    <Section id="notes" label="Field notes" count={posts.length}>
      <ol class="posts">
        {posts.map(p => <li><a href={`/notes/${p.id}/`}><time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time><span>{p.data.title}</span></a></li>)}
      </ol>
      <p class="sec-foot"><a class="text-link" href="/rss.xml">RSS feed</a></p>
    </Section>

    <Section id="bylines" label="Bylines" count={PRESS.bylines.length}>
      <ul class="list">
        {PRESS.bylines.map(b => <li><a href={b.href} {...ext}><span class="k">{b.source}</span><span class="v">{b.title}</span><span class="x">&nearr;</span></a></li>)}
      </ul>
    </Section>

    <Section id="coverage" label="Coverage" count={PRESS.coverage.length}>
      <ul class="list">
        {PRESS.coverage.map(b => <li><a href={b.href} {...ext}><span class="k">{b.source}</span><span class="v">{b.title}</span><span class="x">&nearr;</span></a></li>)}
      </ul>
    </Section>

    <Section id="media" label="Reports & podcast" count={PRESS.media.length}>
      <ul class="list">
        {PRESS.media.map(m => <li><a href={m.href} {...ext}><span class="k">{m.role}</span><span class="v">{m.name}<span class="sub-v">{m.body}</span></span><span class="x">&nearr;</span></a></li>)}
      </ul>
    </Section>

    <Section id="archives" label="Author archives" count={PRESS.archives.length}>
      <ul class="list">
        {PRESS.archives.map(a => <li><a href={a.href} {...ext}><span class="k">Archive</span><span class="v">{a.name}</span><span class="x">&nearr;</span></a></li>)}
      </ul>
    </Section>
  </div>
  <ItemNav current={3} />
</Sheet>
