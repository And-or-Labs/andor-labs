---
import { getCollection } from "astro:content";

import Crumb from "../../components/Crumb.astro";
import ItemNav from "../../components/ItemNav.astro";
import Section from "../../components/Section.astro";
import Subscribe from "../../components/Subscribe.astro";
import { NOTES } from "../../data/site";
import Sheet from "../../layouts/Sheet.astro";
const posts = (await getCollection("blog", p => !p.data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll("-", ".");
---
<Sheet title="Field notes" description="Field notes on GTM, AI and the post-software era." fig="log" color="butter">
  <Crumb slot="crumb" />
  <p class="eyebrow"><span class="br">[4]</span> Field notes</p>
  <h1 class="title">{NOTES.title}</h1>
  <p class="lede">{NOTES.lede}</p>
  <div class="body">
    <Section id="notes" label="Field notes" count={posts.length}>
      <ol class="posts">
        {posts.map(p => <li><a href={`/notes/${p.id}/`}><time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time><span>{p.data.title}</span></a></li>)}
      </ol>
      <p class="sec-foot"><a class="text-link" href="/rss.xml">RSS feed</a></p>
    </Section>

    <Section id="next" label="Next step">
      <div class="card"><Subscribe source="blog-index" /></div>
    </Section>
  </div>
  <ItemNav current={4} />
</Sheet>
