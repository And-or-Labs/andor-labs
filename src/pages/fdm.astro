---
import { book, FDM as F, TESTIMONIALS } from "../data/site";
import Listing from "../layouts/Listing.astro";
const scott = TESTIMONIALS[0];
const track = [
  { company: "Blockthrough", note: "Acquired by eyeo GmbH", result: "3× organic traffic", role: "Director, Marketing & Sales Operations" },
  { company: "AdPushup", note: "Acquired by Geniee, Inc.", result: "Seed to $10M ARR, during tenure", role: "Product Marketing Manager", src: { label: "YourStory", href: "https://yourstory.com/2020/01/startup-adtech-saas-ad-pushup-web-publishers" } },
  { company: "Filament", note: "Client", result: "Positioning, messaging and a rebuilt site", role: "Client engagement", src: { label: "Site", href: "https://www.wearefilament.com" } },
];
---
<Listing
  n={2}
  heading={F.title}
  lede={F.lede}
  description={F.lede}
  price={{ label: F.offer.label, amount: F.offer.price, unit: F.offer.term, note: F.offer.commitment }}
  cta={{ label: F.offer.cta, href: book("fdm-hero") }}
  facts={[
    { k: "For", v: "Media and adtech companies" },
    { k: "Fit", v: "Product has outgrown its positioning, website and pipeline" },
    { k: "Operator", v: "Vishveshwar Jatain, hands-on" },
  ]}
  proofLabel="Track record"
  how={[
    { name: "Diagnose", text: "A written diagnosis of your positioning, website, pipeline and tooling." },
    { name: "Agree", text: "The few changes that will move revenue, with scope and price fixed." },
    { name: "Build", text: "I build them inside your stack, one priority at a time." },
  ]}
  get={F.capabilities.map(c => ({ name: c.name, text: c.work }))}
>
  <div slot="proof" class="proof-track">
    <ol class="ledger">
      {track.map((t, i) => (
        <li>
          <span class="lg-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <div class="lg-co"><span class="co">{t.company}</span><span class="lg-note">{t.note}</span></div>
          <div class="lg-res"><b>{t.result}</b><span class="role">{t.role}</span></div>
          {t.src ? <a class="lg-src" href={t.src.href} target="_blank" rel="noopener">{t.src.label} <span aria-hidden="true">↗</span></a> : <span class="lg-src" aria-hidden="true"></span>}
          {t.company === "Filament" && (
            <figure class="lg-quote">
              <blockquote><p>“{scott.quote}”</p></blockquote>
              <figcaption><cite>{scott.author}, {scott.role}</cite></figcaption>
            </figure>
          )}
        </li>
      ))}
    </ol>
  </div>
</Listing>
