---
import { Image } from "astro:assets";

import afterImage from "../assets/gtm/filament-after.png";
import beforeImage from "../assets/gtm/filament-before.png";
import Crumb from "../components/Crumb.astro";
import ItemNav from "../components/ItemNav.astro";
import Section from "../components/Section.astro";
import { BOOKING_URL, GTM as G, HOME, TESTIMONIALS } from "../data/site";
import Sheet from "../layouts/Sheet.astro";
const [scott, marty] = TESTIMONIALS;
---
<Sheet title="GTM Packages" description={G.lede} fig="growth" color="coral">
  <Crumb slot="crumb" />
  <p class="eyebrow"><span class="br">[2]</span> GTM Packages</p>
  <h1 class="title">{G.title}</h1>
  <p class="lede">Positioning, websites, organic growth, and custom automation for adtech companies. Strategy and implementation, handled together.</p>
  <p class="founder">{HOME.founder} You work directly with me.</p>
  <div class="body service-content">
    <Section id="experience" label="Operating experience">
      <dl class="facts career-facts">
        {G.experience.map(e => <div><dt>{e.company}</dt><dd>{e.result}</dd></div>)}
      </dl>
    </Section>

    <Section id="packages" label="Packages" count={G.offers.length}>
      <div class="pkgs">
        {G.offers.map(o => (
          <article class="card pkg">
            <p class="label c">{o.label}</p>
            <h3>{o.name}</h3>
            <p class="price"><b>{o.price}</b> {o.term}</p>
            <p class="offer-term">{o.commitment}</p>
            <p>{o.for}</p>
            <details>
              <summary>Scope &amp; working together</summary>
              <div class="offer-detail">
                <p>{o.description}</p>
                <ul>{o.scope.map(item => <li>{item}</li>)}</ul>
                <a class="text-link" href={BOOKING_URL} target="_blank" rel="noopener">{o.cta} <span aria-hidden="true">↘</span></a>
              </div>
            </details>
          </article>
        ))}
      </div>
      <div class="ctas"><a class="btn primary" href={BOOKING_URL} target="_blank" rel="noopener">Discuss your project <span class="arr" aria-hidden="true">↗</span></a></div>
    </Section>

    <figure class="quote">
      <blockquote><p>{marty.quote}</p></blockquote>
      <figcaption><cite>{marty.author}, {marty.role}</cite></figcaption>
    </figure>

    <Section id="capabilities" label="What I build" count={G.capabilities.length}>
      <ul class="list capabilities">
        {G.capabilities.map((c, i) => <li><div><span class="k">0{i + 1}</span><span class="v">{c.name}<span class="capability-description">{c.work}</span></span></div></li>)}
      </ul>
    </Section>

    <Section id="filament" label="Selected work / Filament">
      <p>{G.caseStudy.line}</p>
      <p class="label case-metrics">{G.caseStudy.metrics.join(" / ")}</p>
      <details class="case-details">
        <summary>View the redesign</summary>
        <div class="comparison">
          <figure>
            <figcaption class="label">Before / WordPress</figcaption>
            <div class="site-preview" tabindex="0" role="region" aria-label="Filament before redesign, scroll to explore">
              <Image src={beforeImage} alt="Filament's previous website with a white background, uppercase headline, and purple YouTube advertising graphics." width={900} format="webp" quality={75} loading="lazy" />
            </div>
          </figure>
          <figure>
            <figcaption class="label">After / Redesign</figcaption>
            <div class="site-preview" tabindex="0" role="region" aria-label="Filament after redesign, scroll to explore">
              <Image src={afterImage} alt="Filament's redesigned website with a navy background, serif product messaging, and a clearer product interface preview." width={900} format="webp" quality={75} loading="lazy" />
            </div>
          </figure>
        </div>
        <p class="evidence-note">Redesign captures, March 2026. Technical measurements recorded at launch.</p>
        <a class="text-link" href={G.caseStudy.href} target="_blank" rel="noopener">Visit Filament <span aria-hidden="true">↗</span></a>
      </details>
      <figure class="quote client-quote">
        <blockquote><p>{scott.quote}</p></blockquote>
        <figcaption><cite>{scott.author}, {scott.role}</cite></figcaption>
      </figure>
    </Section>

    <Section id="next" label="Next step">
      <p>{G.process}</p>
      <a class="text-link" href={BOOKING_URL} target="_blank" rel="noopener">Book a call <span aria-hidden="true">↗</span></a>
    </Section>
  </div>
  <ItemNav current={2} />
</Sheet>
