---
import Crumb from "../components/Crumb.astro";
import ItemNav from "../components/ItemNav.astro";
import Section from "../components/Section.astro";
import { MEDIACONTEXT as M } from "../data/site";
import Sheet from "../layouts/Sheet.astro";
---
<Sheet title="MediaContext" description={M.title + " " + M.lede} fig="radar" color="blue">
  <Crumb slot="crumb" />
  <p class="eyebrow"><span class="br">[1]</span> MediaContext</p>
  <h1 class="title">{M.title}</h1>
  <p class="lede">{M.lede}</p>
  <div class="body">
    <Section id="glance" label="At a glance">
      <dl class="facts">
        {M.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </Section>
    <Section id="product" label="Product">
      <figure class="card shot-card">
        <img class="shot" src={M.image.src} alt={M.image.alt} width="2880" height="1800" loading="lazy" decoding="async" />
        <figcaption class="label">Publishers view / ranked by traffic</figcaption>
      </figure>
    </Section>
    <Section id="next" label="Next step">
      <div class="ctas">
        <a class="btn primary" href={M.href} target="_blank" rel="noopener">Visit mediacontext.dev <span class="arr" aria-hidden="true">&nearr;</span></a>
      </div>
    </Section>
  </div>
  <ItemNav current={1} />
</Sheet>
