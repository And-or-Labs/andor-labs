---
import { MEDIACONTEXT as M, book } from "../data/site";
import Listing from "../layouts/Listing.astro";
---
<Listing
  n={1}
  heading={M.title}
  lede="Market intelligence for the premium open web, built for adtech teams that sell to publishers. Synthetic browsers render every page, so each answer is observed on the live site, not inferred."
  description={M.lede}
  price={{ label: "Subscription", amount: "$1,000", unit: "/ month", note: "App, REST API and MCP" }}
  cta={{ label: M.cta, href: book("mediacontext-hero") }}
  facts={[
    { k: "Coverage", v: "Top 100,000 premium publishers" },
    { k: "Fields", v: "Sales house, ad formats, header bidding, ad density" },
    { k: "Refresh", v: "Weekly scans, every fact dated" },
  ]}
  proofLabel="Publishers view"
  how={[
    { name: "Land", text: "Publishers with no sign of you. Displace a sales house or take the greenfield." },
    { name: "Expand", text: "Once you are in, the sister sites in the same media group." },
    { name: "Defend", text: "Your accounts where a competitor just showed up." },
  ]}
  get={[
    { name: "Top prospects", text: "Accounts ranked by fit, with the reason each one made the list." },
    { name: "Signals", text: "Rules over any field, on any publisher or list." },
    { name: "Buying committees", text: "Ranked by who decides, not by who has the longest title." },
  ]}
>
  <figure slot="proof" class="proof-shot">
    <a class="proof-media" href={M.image.src} target="_blank" rel="noopener" aria-label="Open the full-size MediaContext product screenshot">
      <img class="shot" src={M.image.src} alt={M.image.alt} width="2880" height="1800" decoding="async" />
    </a>
    <figcaption class="proof-cap"><span class="label">Ranked by traffic</span><a class="text-link" href={M.image.src} target="_blank" rel="noopener">View full size <span aria-hidden="true">↗</span></a></figcaption>
  </figure>
</Listing>
