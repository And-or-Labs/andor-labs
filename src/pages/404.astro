---
import { Button, Label, Panel } from "@andor/ds";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
---

<DefaultLayout title="Not found | And/or Labs" description="This page does not exist.">
  <Panel>
    <section class="container flex min-h-[70vh] flex-col items-start justify-center pb-20 pt-32">
      <Label marker={4}>404</Label>
      <h1 class="mt-5 max-w-xl text-4xl font-semibold tracking-[-0.035em] md:text-5xl">This page went to market without us.</h1>
      <p class="mt-4 max-w-md text-lg text-muted-foreground">The link is old or mistyped. Everything that still exists is one click away.</p>
      <div class="mt-8 flex gap-3">
        <Button href="/" size="lg">Back to home</Button>
        <Button href="/blog/" size="lg" variant="outline">Read the field notes</Button>
      </div>
    </section>
  </Panel>
</DefaultLayout>
