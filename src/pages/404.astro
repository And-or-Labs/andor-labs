---
import Crumb from "../components/Crumb.astro";
import ItemNav from "../components/ItemNav.astro";
import Section from "../components/Section.astro";
import Sheet from "../layouts/Sheet.astro";
---
<Sheet title="Not found" fig="empty">
  <Crumb slot="crumb" />
  <p class="eyebrow"><span class="br">[404]</span> File not found</p>
  <h1 class="title">Bad command or file name.</h1>
  <p class="lede">That page moved, or never existed. The microscope on the right is also looking for it.</p>
  <div class="body">
    <Section id="next" label="Next step">
      <div class="ctas"><a class="btn primary" href="/" data-back>Back to the index</a></div>
    </Section>
  </div>
  <ItemNav current={0} />
</Sheet>
