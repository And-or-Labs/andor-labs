---
import Sheet from "../layouts/Sheet.astro";
import Crumb from "../components/Crumb.astro";
import ItemNav from "../components/ItemNav.astro";
import { EXPERIMENTS } from "../data/site";
---
<Sheet title="Experiments" description="Things we built to see what happens: Megafly and the zero-click doomsday clock." fig="flask" color="green">
  <Crumb slot="crumb" />
  <p class="eyebrow"><span class="br">[3]</span> Experiments</p>
  <h1 class="title">Things we built to see what happens.</h1>
  <p class="lede">Small, strange, working software. Some of it becomes product. Most of it becomes a note.</p>
  <div class="body">
    {EXPERIMENTS.map(x => (
      <article class="exp">
        <p class="label c">{x.file}</p>
        <h2>{x.name}</h2>
        <p>{x.body}</p>
        <div class="ctas">
          <a class="btn primary" href={x.href} {...(x.external ? { target: "_blank", rel: "noopener" } : {})} data-astro-reload={x.external ? undefined : true}>{x.cta} {x.external ? "\u2197" : "\u2192"}</a>
        </div>
      </article>
    ))}
    <p class="label">More in the open on <a href="https://github.com/eclecticv" target="_blank" rel="noopener">GitHub &nearr;</a></p>
  </div>
  <ItemNav current={3} />
</Sheet>
