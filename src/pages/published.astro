---
import Sheet from "../layouts/Sheet.astro";
import Crumb from "../components/Crumb.astro";
import ItemNav from "../components/ItemNav.astro";
import { PRESS } from "../data/site";
---
<Sheet title="Published work" description="Bylines and coverage in Digiday, Adweek, AdExchanger, ExchangeWire, eMarketer and others." fig="press" color="lilac">
  <Crumb slot="crumb" />
  <p class="eyebrow"><span class="br">[4]</span> Published work</p>
  <h1 class="title">Bylines and coverage.</h1>
  <p class="lede">Writing about ad blocking, publisher revenue and the attention economy, in the trade press and on the record.</p>
  <div class="body">
    <div>
      <p class="label" style="margin-bottom:8px">Bylines</p>
      <ul class="list">
        {PRESS.bylines.map(b => <li><a href={b.href} target="_blank" rel="noopener"><span class="k">{b.source}</span><span class="v">{b.title}</span><span class="x">&nearr;</span></a></li>)}
      </ul>
    </div>
    <div>
      <p class="label" style="margin-bottom:8px">Coverage</p>
      <ul class="list">
        {PRESS.coverage.map(b => <li><a href={b.href} target="_blank" rel="noopener"><span class="k">{b.source}</span><span class="v">{b.title}</span><span class="x">&nearr;</span></a></li>)}
      </ul>
    </div>
    <div>
      <p class="label" style="margin-bottom:8px">Archives</p>
      <div class="ctas">
        {PRESS.archives.map(a => <a class="btn" href={a.href} target="_blank" rel="noopener">{a.name} &nearr;</a>)}
      </div>
    </div>
  </div>
  <ItemNav current={4} />
</Sheet>
