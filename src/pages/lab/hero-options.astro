---
/**
 * Hero treatments — one image, three ways the channel can lie on it.
 *
 * Dev-only comparison page, same convention as the rest of /lab: it builds to a
 * redirect stub in production and is excluded from the sitemap.
 *
 * The brief: the top of the hero must not be empty, and the image should wrap
 * the ask rather than sit under it as a footer band. Each option below answers
 * that differently, and each is a real layout rather than a mockup, so what you
 * pick is what ships.
 */
import Base from "../../layouts/Base.astro";

const H1 = "Don't just go-to-market. Win it.";
const SUB =
  "We're a boutique consultancy helping early-stage technology startups find product-market fit, accelerate revenue growth, and win their category.";

/**
 * Three tunings of the dissolve.
 *
 * The band is gone in all of them: the image is ONE element at full bleed and
 * the copy sits in a clearing burned through it, so there is no edge anywhere
 * for the eye to read as a cut, and no second crop to disagree with the first.
 *
 * What differs is the SHAPE of the clearing. A linear clearing still banks the
 * page horizontally — softly, but it is still a horizon that isn't in the
 * picture. A radial one has no direction at all.
 */
const OPTIONS = [
  {
    id: "d1",
    name: "Dissolve · tightened",
    note: "The fade from A3, pulled in at both ends so the sky and the lake keep their colour. Shortest change from what you liked.",
  },
  {
    id: "d2",
    name: "Dissolve · low copy",
    note: "Same fade, but the clearing sits below centre — the mountain and cloud bank stay legible above the headline instead of bleaching out.",
  },
  {
    id: "d3",
    name: "Clearing",
    note: "No horizontal fade at all. An oval of paper burned behind the copy, so the picture runs unbroken to all four edges and the only soft edge is the one around the words.",
  },
];
---

<Base title="Hero treatments — And/or Labs" noIndex>
  <main class="lab">
    <header class="lab__head">
      <h1 class="lab__title">Hero treatments</h1>
      <p class="lab__lede">
        Three tunings of the dissolve. Each is a real
        layout, not a mockup.
      </p>
    </header>

    {OPTIONS.map((o) => (
      <section class="lab__opt">
        <div class="lab__meta">
          <span class="lab__id">{o.id.toUpperCase()}</span>
          <span class="lab__name">{o.name}</span>
          <p class="lab__note">{o.note}</p>
        </div>

        <div class={`hx hx--${o.id}`}>
          {/* ONE image, always. The channel is an overlay on top of it, never a
              gap between two crops. */}
          <img class="hx__bg" src="/rockies.png" alt="" aria-hidden="true" />
          <div class="hx__channel"></div>

          <div class="hx__inner">
            <span class="hx__eyebrow">Est. 2025</span>
            <h2 class="hx__h1">{H1}</h2>
            <p class="hx__sub">{SUB}</p>
            <form class="hx__form" onsubmit="return false">
              <div class="hx__row">
                <input class="hx__input" type="email" placeholder="you@company.com" aria-label="Work email" />
                <button class="hx__go" type="submit">Free audit</button>
              </div>
            </form>
          </div>
        </div>
      </section>
    ))}
  </main>
</Base>

<style is:global>
  .lab { max-width: 1280px; margin: 0 auto; padding: 48px 24px 96px; }
  .lab__head { margin-bottom: 40px; }
  .lab__title { font-family: var(--font-display); font-weight: 400; font-size: 40px; margin: 0; }
  .lab__lede { font-family: var(--font-serif); font-size: 17px; color: var(--ink-600); max-width: 60ch; margin: 10px 0 0; }
  .lab__opt { margin-bottom: 72px; }
  .lab__meta { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
  .lab__id { font-family: var(--font-mono); font-size: 11px; color: var(--blue-600); letter-spacing: 0.12em; }
  .lab__name { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-900); }
  .lab__note { font-family: var(--font-serif); font-size: 15px; line-height: 1.5; color: var(--ink-600); margin: 0; flex: 1 1 340px; }

  /* ── shared hero shell ──────────────────────────────────────────────── */
  .hx {
    position: relative; overflow: hidden; background: var(--paper);
    border: 1px solid var(--ink-200);
    display: flex; flex-direction: column; min-height: 560px;
  }
  .hx__inner {
    position: relative; z-index: 2; flex: 1 1 auto;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 40px 24px;
  }
  .hx__eyebrow {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--ink-500);
  }
  .hx__h1 {
    font-family: var(--font-display); font-weight: 400; font-size: 40px; line-height: 1.14;
    margin: 12px 0 0; max-width: 18ch; color: var(--ink-900);
  }
  .hx__sub {
    font-family: var(--font-serif); font-size: 18px; line-height: 1.5;
    color: var(--ink-600); max-width: 42ch; margin: 16px 0 0;
  }
  .hx__ctawrap { position: relative; width: 100%; max-width: 26rem; margin: 28px auto 0; }
  .hx__form { position: relative; z-index: 2; }
  .hx__row {
    display: flex; align-items: stretch;
    border: 1px solid var(--ink-200); border-radius: var(--radius-pill);
    background: var(--paper-pure); overflow: hidden;
    box-shadow: 0 1px 2px rgba(20,21,26,.04), 0 6px 20px -6px rgba(20,21,26,.12);
  }
  .hx__input {
    flex: 1 1 auto; min-width: 0; border: 0; background: transparent;
    font-family: var(--font-mono); font-size: 16px; padding: 0 6px 0 18px; min-height: 44px;
  }
  .hx__input:focus { outline: none; }
  .hx__go {
    flex: none; border: 0; margin: 3px; padding: 0 18px; border-radius: var(--radius-pill);
    background: var(--blue-600); color: var(--paper-pure); cursor: pointer;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase;
  }
  .hx img { image-rendering: pixelated; display: block; }

  /* ── shared: one image, one channel ─────────────────────────────────── */
  .hx__bg { position: absolute; left: 0; right: 0; width: 100%; z-index: 0; }
  .hx__channel { position: absolute; left: 0; right: 0; z-index: 1; pointer-events: none; }
  .hx__inner { justify-content: center; }

  /* Shared: one full-bleed image, cover, 620 tall. `cover` on a 4:1 source in a
     2:1 box scales by HEIGHT — the whole picture survives vertically and the
     sides crop, which is why nothing here looks squashed. */
  .hx--d1, .hx--d2, .hx--d3 { min-height: 620px; }
  .hx--d1 .hx__bg, .hx--d2 .hx__bg, .hx--d3 .hx__bg {
    top: 0; height: 100%; object-fit: cover; object-position: center;
  }
  .hx--d1 .hx__channel, .hx--d2 .hx__channel, .hx--d3 .hx__channel { top: 0; bottom: 0; }

  /* ── D1 · tightened ─────────────────────────────────────────────────── */
  .hx--d1 .hx__channel {
    background: linear-gradient(to bottom,
      transparent 0%, rgba(255,255,255,.30) 16%, rgba(255,255,255,.93) 32%,
      #fff 42%, #fff 60%,
      rgba(255,255,255,.93) 70%, rgba(255,255,255,.30) 86%, transparent 100%);
  }

  /* ── D2 · low copy ──────────────────────────────────────────────────
     The clearing is pushed down, and the content with it, so the top third of
     the frame — where the peak and the cloud bank are — stays a picture. */
  .hx--d2 .hx__channel {
    background: linear-gradient(to bottom,
      transparent 0%, transparent 22%, rgba(255,255,255,.55) 38%,
      #fff 52%, #fff 72%,
      rgba(255,255,255,.80) 84%, transparent 100%);
  }
  .hx--d2 .hx__inner { justify-content: flex-end; padding-bottom: 96px; }

  /* ── D3 · clearing ──────────────────────────────────────────────────
     A radial burn rather than a band. There is no horizon in the overlay, so
     the picture reads as continuous to all four edges and the only soft edge
     anywhere is the halo around the words. */
  .hx--d3 .hx__channel {
    background: radial-gradient(58% 46% at 50% 52%,
      #fff 0%, #fff 42%, rgba(255,255,255,.88) 62%,
      rgba(255,255,255,.45) 80%, transparent 100%);
  }
</style>
