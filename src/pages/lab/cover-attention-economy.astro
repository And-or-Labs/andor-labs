---
/**
 * Render source for the Attention Economy issue image — a news-style cut-out
 * collage, dither-treated.
 *
 * A /lab/ route for the same reason the OG cards and the Weekly Overfit cover
 * are: astro.config.mjs's sitemap filter already excludes /lab/, and authoring
 * it as a real page means it uses the site's own tokens rather than a lookalike.
 * It is a rendering jig, not a page.
 *
 * ── Why it looks like this ──
 *
 * NO TYPE. Not a masthead, not a coverline, not a wordmark. A featured image
 * sits above a headline that already says all of it; setting the words twice
 * makes the image a slide. Everything here is picture.
 *
 * THE ARRANGEMENT is the argument. Printed page bottom-left, then the screen,
 * then a carriage where every face is already lit — and the brand marks drift
 * up and right, away from the people. That diagonal is the brief's own
 * through-line: value moving into the AI interface while the click thins.
 *
 * PHOTOS CARRY THE BLUE, marks stay ink. The cut-outs are the house dithered
 * duotone (blue-700 on blue-050) and the brand marks are flat ink-900 on paper,
 * because the icon rules reserve blue for solid/active variants and make
 * everything else ink. It also gives the collage a hierarchy: the photographs
 * are the image, the marks annotate it.
 *
 * NOTHING IS ROTATED. A rotated dither resamples — nearest-neighbour rotation
 * moirés the cells and smooth rotation averages them into greys the two-colour
 * palette does not contain. The collage gets its energy from overlap and scale
 * instead, which is also the more orthogonal, more house-like answer.
 *
 * SIZES ARE LOAD-BEARING. Every cut-out is baked at the exact pixel size it is
 * composited at (see scripts/bake-attention-cutouts.mts) so the 2x capture
 * doubles each dither cell into a hard 2x2 block. Move a size here and re-bake.
 *
 * Sources are Openverse, all three CC0 — chosen for that, so no credit line has
 * to ride on the image. Brand marks are HackerNoon's Pixel Icon Library
 * (CC BY 4.0), the only approved set.
 *
 * To re-render:  node scripts/render-linkedin-cover.mjs
 */
import fs from "node:fs";
import path from "node:path";
import "../../styles/main.css";

const BASE = path.join(process.cwd(), ".scratch", "newsletter", "attention-economy");

const cut = (file: string) =>
  `data:image/png;base64,${fs.readFileSync(path.join(BASE, "cutouts", file)).toString("base64")}`;

/** Inline the mark and strip the XML prolog some of them ship with. */
const mark = (name: string) =>
  fs
    .readFileSync(path.join(BASE, "marks", `${name}.svg`), "utf8")
    .replace(/<\?xml[^>]*\?>/, "")
    .trim();

/** left/top/width/height in canvas px. Baked sizes must match `w`/`h`. */
const CUTOUTS = [
  { src: "commuters.png", left: 62, top: 112, w: 330, h: 418 },
  { src: "screenlit.png", left: 520, top: 336, w: 320, h: 240 },
];

/** Sized by how much of the week each one owns; OpenAI leads three of five. */
const MARKS = [
  { name: "open-ai", left: 352, top: 172, size: 144 },
  { name: "google", left: 556, top: 92, size: 112 },
  { name: "perplexity", left: 830, top: 120, size: 100 },
  { name: "anthropic", left: 960, top: 300, size: 100 },
  { name: "youtube", left: 800, top: 452, size: 108 },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Issue image — The Attention Economy</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <div class="cg aol-grid-blue">
      {
        CUTOUTS.map((c) => (
          <span
            class="cg__cut"
            style={`left:${c.left}px; top:${c.top}px; width:${c.w}px; height:${c.h}px`}
          >
            <img src={cut(c.src)} alt="" width={c.w} height={c.h} />
          </span>
        ))
      }
      {
        MARKS.map((m) => (
          <span
            class="cg__mark"
            style={`left:${m.left}px; top:${m.top}px; width:${m.size}px; height:${m.size}px`}
            set:html={mark(m.name)}
          />
        ))
      }
    </div>
  </body>
</html>

<style>
  /* Fixed pixel values throughout — this is a 1200x644 canvas, not a responsive
     page. The COLOURS still come from tokens so it cannot drift from the
     palette. */
  :global(body) { margin: 0; }
  /* The dev toolbar injects into every page and lands inside the captured
     frame. This is only ever rendered from `npm run dev`. */
  :global(astro-dev-toolbar) { display: none !important; }

  .cg {
    position: relative;
    width: 1200px;
    height: 644px;
    overflow: hidden;
    background-color: var(--paper);
  }

  /* Cut-outs and marks share the clipping construction — ink hairline, hard
     offset shadow, near-square corners — so a photograph and a logo read as
     the same kind of object on the page. */
  .cg__cut,
  .cg__mark {
    position: absolute;
    display: block;
    box-sizing: border-box;
    background: var(--paper);
    border: 1.5px solid var(--ink-900);
    border-radius: var(--radius-md);
  }

  .cg__cut {
    overflow: hidden;
    box-shadow: 7px 7px 0 0 var(--ink-900);
  }
  .cg__cut img {
    display: block;
    width: 100%;
    height: 100%;
    /* The source is a 1-bit dither. Smooth scaling averages neighbouring cells
       into greys the palette does not contain, so the cells stay hard. */
    image-rendering: pixelated;
  }

  .cg__mark {
    display: grid;
    place-items: center;
    color: var(--ink-900);
    box-shadow: 5px 5px 0 0 var(--ink-900);
  }
  /* Sized as a share of the TILE (a percentage on a child resolves against its
     own containing block), never as tile padding — see the note above. */
  .cg__mark :global(svg) {
    width: 62%;
    height: 62%;
    fill: currentColor;
    display: block;
  }
</style>
