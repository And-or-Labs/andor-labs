---
import NextNotes from "../components/NextNotes.astro";
import Section from "../components/Section.astro";
import { PRESS, RECORD } from "../data/site";
import Page from "../layouts/Page.astro";
---
<Page
  n={4}
  heading={RECORD.title}
  lede={RECORD.lede}
  spec={[
    { k: "Bylines", v: `${PRESS.bylines.length}`, href: "#bylines" },
    { k: "Archives", v: `${PRESS.authorArchives.length}`, href: "#archives" },
    { k: "Earned media", v: `${PRESS.earnedMedia.length}`, href: "#earned" },
    { k: "Citations", v: `${PRESS.citations.length}`, href: "#citations" },
    { k: "Reports", v: `${PRESS.reports.length}`, href: "#reports" },
    { k: "Podcast", v: `${PRESS.podcast.length}`, href: "#podcast" },
    { k: "Investments", v: `${PRESS.investments.length}`, href: "#investments" },
  ]}
>
  <Section label="Bylines & quotes" count={PRESS.bylines.length} id="bylines">
    <ul class="list">
      {PRESS.bylines.map(b => (
        <li>{b.href
          ? <a href={b.href} target="_blank" rel="noopener"><span class="k">{b.source}</span><span class="v">{b.title}</span><span class="x" aria-hidden="true">&nearr;</span></a>
          : <div><span class="k">{b.source}</span><span class="v">{b.title}</span></div>}
        </li>
      ))}
    </ul>
  </Section>
  <Section label="Author archives" count={PRESS.authorArchives.length} id="archives">
    <ul class="list">
      {PRESS.authorArchives.map(a => <li><a href={a.href} target="_blank" rel="noopener"><span class="k">Archive</span><span class="v">{a.name}</span><span class="x" aria-hidden="true">&nearr;</span></a></li>)}
    </ul>
  </Section>
  <Section label="Earned media" count={PRESS.earnedMedia.length} id="earned">
    <ul class="list">
      {PRESS.earnedMedia.map(c => <li><a href={c.href} target="_blank" rel="noopener"><span class="k">{c.source}</span><span class="v">{c.title}</span><span class="x" aria-hidden="true">&nearr;</span></a></li>)}
    </ul>
  </Section>
  <Section label="Research citations" count={PRESS.citations.length} id="citations">
    <ul class="list">
      {PRESS.citations.map(c => (
        <li>{c.href
          ? <a href={c.href} target="_blank" rel="noopener"><span class="k">{c.year}</span><span class="v">{c.title}<span class="sub-v">{c.source}</span></span><span class="x" aria-hidden="true">&nearr;</span></a>
          : <div><span class="k">{c.year}</span><span class="v">{c.title}<span class="sub-v">{c.source}</span></span></div>}
        </li>
      ))}
    </ul>
  </Section>
  <Section label="Reports" count={PRESS.reports.length} id="reports">
    <ul class="list">
      {PRESS.reports.map(m => <li><a href={m.href} target="_blank" rel="noopener"><span class="k">{m.role}</span><span class="v">{m.name}<span class="sub-v">{m.body}</span></span><span class="x" aria-hidden="true">&nearr;</span></a></li>)}
    </ul>
  </Section>
  <Section label="Podcast" count={PRESS.podcast.length} id="podcast">
    <ul class="list">
      {PRESS.podcast.map(m => <li><a href={m.href} target="_blank" rel="noopener"><span class="k">{m.role}</span><span class="v">{m.name}<span class="sub-v">{m.body}</span></span><span class="x" aria-hidden="true">&nearr;</span></a></li>)}
    </ul>
  </Section>
  <Section label="Investments" count={PRESS.investments.length} id="investments">
    <ul class="list">
      {PRESS.investments.map(i => <li><a href={i.href} target="_blank" rel="noopener"><span class="k">{i.location}</span><span class="v">{i.name}<span class="sub-v">{i.description}</span></span><span class="x" aria-hidden="true">&nearr;</span></a></li>)}
    </ul>
  </Section>
  <NextNotes slot="next" source="record" />
</Page>
